# Version de l'image (latest = derniere version de main ; sha-xxxxxxx pour figer).
API_TAG=latest

# Port expose sur la machine hote (docker-compose).
API_PORT=8080

# Origines autorisees a appeler l'API (separees par des virgules, * = toutes).
ALLOWED_ORIGINS=https://gatcha.2gether-asso.fr

# Le conteneur sert aussi le site (embarque dans l'image). Vider pour une
# API seule.
SITE_DIR=/app/site
# Adresse de l'API injectee dans le js/config.js du site servi (meme domaine).
SITE_API_BASE=/webhook/

# Mot de passe de la page site/admin-db.html (long et aleatoire, ex: openssl rand -hex 24).
ADMIN_TOKEN=

# Secrets Discord (remplacent les valeurs "CHANGE-MOI" des workflows).
DISCORD_CLIENT_SECRET=
DISCORD_WEBHOOK_URL=
# Optionnels (deja renseignes dans les workflows) :
DISCORD_CLIENT_ID=
DISCORD_REDIRECT_URI=
DISCORD_GUILD_ID=

# Sauvegardes automatiques vers Azure Blob Storage (vide = desactivees).
# URL SAS de CONTENEUR avec les droits Read, Add, Create, Write, Delete, List :
#   Portail Azure > compte de stockage > Conteneurs > <conteneur> >
#   "Generer un SAS" (ou Shared access tokens), expiration lointaine.
# Forme : https://<compte>.blob.core.windows.net/<conteneur>?sv=...&sig=...
AZURE_BACKUP_SAS_URL=
# Dossier dans le conteneur, frequence (heures) et duree de conservation (jours).
BACKUP_PREFIX=backups
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=30

# Suivi des erreurs GlitchTip (projet "API"). DSN complet affiche par
# GlitchTip : https://<cle publique>@glitchtip.matiboux.com/2 - vide = desactive.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Cle de signature des jetons de connexion (long et aleatoire, ex: openssl rand -hex 32).
# Vide = generee au 1er demarrage et gardee en base. La changer deconnecte tout le monde.
AUTH_SECRET=
# off = pas de verification des jetons (developpement local uniquement).
# AUTH_MODE=off

# Admins des routes natives (memes ID Discord que les workflows), separes par des virgules.
# ADMIN_DISCORD_IDS=785223211730075709,184008667690041345

# Notifications push : cles VAPID generees automatiquement au 1er demarrage
# (gardees en base). A renseigner seulement pour imposer ses propres cles.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://gatcha.2gether-asso.fr

# 0 pour couper le journal des requetes.
LOG_REQUESTS=1
