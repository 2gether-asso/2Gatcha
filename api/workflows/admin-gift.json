      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// A adapter une seule fois : ID du document Grist + IDs Discord admin (meme\n// liste que les autres workflows admin-*).\nconst docId = 'cRP1WgZQv7KmwmVrUbuEF8';\nconst adminDiscordIds = ['785223211730075709', '184008667690041345'];\nconst body = $input.first().json.body || {};\nconst discordId = (body.discordId || '').toString();\nreturn [{\n  json: {\n    docId,\n    discordId,\n    isAdmin: adminDiscordIds.includes(discordId),\n    targetUserId: Number(body.targetUserId),\n    giftType: (body.giftType || '').toString(),\n    cardId: Number(body.cardId),\n    finish: (body.finish || 'normal').toString(),\n    quality: (body.quality || 'good').toString(),\n    quantity: Number(body.quantity) || 1\n  }\n}];"
      }
