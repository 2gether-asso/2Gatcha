    {
      "id": "compute-gift",
      "name": "Compute Gift",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -40,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nfunction firstAttachment(v) {\n  if (!Array.isArray(v) || !v.length) return null;\n  const ids = v[0] === 'L' ? v.slice(1) : v;\n  return ids.length ? ids[0] : null;\n}\nconst cfg = $('Set Config').first().json;\nif (!cfg.isAdmin) return [{ json: { ok: false, error: 'forbidden' } }];\n\nconst users = $('Get Users').all().map((i) => i.json).filter((r) => r.id != null);\nconst targetUser = users.find((u) => u.id === cfg.targetUserId);\nif (!targetUser) return [{ json: { ok: false, error: 'unknown_user' } }];\n\nconst quantity = Math.max(1, Math.min(100, cfg.quantity || 1));\n\nif (cfg.giftType === 'booster') {\n  return [{ json: {\n    ok: true, mutation: 'booster', targetUserId: cfg.targetUserId, quantity,\n    newBoosterCount: (targetUser.BoosterCount || 0) + quantity,\n    newStardust: targetUser.StardustCount || 0\n  } }];\n}\n\nif (cfg.giftType === 'dust') {\n  return [{ json: {\n    ok: true, mutation: 'dust', targetUserId: cfg.targetUserId, quantity,\n    newBoosterCount: targetUser.BoosterCount || 0,\n    newStardust: (targetUser.StardustCount || 0) + quantity\n  } }];\n}\n\nif (cfg.giftType !== 'card') {\n  return [{ json: { ok: false, error: 'invalid_gift_type' } }];\n}\n\nconst cards = $('Get Cards').all().map((i) => i.json).filter((r) => r.id != null);\nconst card = cards.find((c) => c.id === cfg.cardId);\nif (!card) return [{ json: { ok: false, error: 'card_not_found' } }];\n\nconst rarities = $('Get Rarities').all().map((i) => i.json).filter((r) => r.id != null);\nconst rarityRow = rarities.find((r) => r.id === refId(card.Rarity));\nconst rarity = rarityRow ? { id: rarityRow.id, name: rarityRow.Name, key: rarityRow.Key, colorHex: rarityRow.ColorHex } : null;\n\nconst FINISH_KEYS = ['normal', 'holo', 'gold', 'ghost', 'diamond', 'rainbow'];\nconst QUALITY_KEYS = ['damaged', 'worn', 'good', 'mint'];\nconst finish = FINISH_KEYS.includes(cfg.finish) ? cfg.finish : 'normal';\nconst quality = QUALITY_KEYS.includes(cfg.quality) ? cfg.quality : 'good';\n\n// Plus de quota (Cards.MaxSerial, voir grist/SCHEMA.md \"Numeros de serie -\n// plus de quota\") : on suit QUELS numeros sont utilises (pas juste un\n// compteur) pour reattribuer le plus petit numero libre a chaque exemplaire\n// offert, comme partout ailleurs (open-pack/craft/echange...).\nconst allPulls = $('Get Pulls').all().map((i) => i.json).filter((r) => r.id != null);\nconst usedSerials = new Set();\nallPulls.forEach((p) => { if (refId(p.Card) === card.id && p.SerialNumber != null) usedSerials.add(p.SerialNumber); });\nfunction nextSerial() {\n  for (let n = 1; ; n++) { if (!usedSerials.has(n)) { usedSerials.add(n); return n; } }\n}\n\n// Un don admin ne declenche JAMAIS Cards.FirstObtainedBy : ce badge doit\n// rester reserve a une VRAIE premiere decouverte en jeu, pas a un don de\n// compensation/test qui volerait le merite a un joueur.\nconst now = Math.floor(Date.now() / 1000);\nconst batchId = `admin-gift-${cfg.targetUserId}-${Date.now()}`;\nconst items = [];\nfor (let i = 0; i < quantity; i++) {\n  items.push({\n    json: {\n      ok: true, mutation: 'card',\n      targetUserId: cfg.targetUserId,\n      cardId: card.id, name: card.Name, artist: card.Artist, imageId: firstAttachment(card.Image),\n      rarity, obtainedAt: now, batchId,\n      serialNumber: nextSerial(),\n      finish, quality\n    }\n  });\n}\nreturn items;"
      }
    },
