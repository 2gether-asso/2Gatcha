        "jsCode": "// A adapter une seule fois : ID du document Grist + ID(s) Discord autorises\n// a administrer les codes (meme liste que admin-codes.json).\nconst body = $input.first().json.body || {};\nconst adminDiscordIds = ['785223211730075709', '184008667690041345'];\nconst discordId = (body.discordId || '').toString();\nreturn [{ json: {\n  docId: 'cRP1WgZQv7KmwmVrUbuEF8',\n  isAdmin: adminDiscordIds.includes(discordId),\n  confirm: (body.confirm || '').toString(),\n  targetPseudo: (body.targetPseudo || '').toString().trim()\n} }];\n"
