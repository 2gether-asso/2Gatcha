    {
      "id": "build-reset-plan",
      "name": "Build Reset Plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        260
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nconst cfg = $('Set Config').first().json;\nconst pulls = $('Get Pulls').all().map((i) => i.json).filter((r) => r.id != null);\nconst trades = $('Get Trades').all().map((i) => i.json).filter((r) => r.id != null);\nconst quests = $('Get Daily Quests').all().map((i) => i.json).filter((r) => r.id != null);\nconst weeklyQuests = $('Get Weekly Quests').all().map((i) => i.json).filter((r) => r.id != null);\nconst redemptions = $('Get Code Redemptions').all().map((i) => i.json).filter((r) => r.id != null);\nconst inventory = $('Get Booster Inventory').all().map((i) => i.json).filter((r) => r.id != null);\nconst users = $('Get Users').all().map((i) => i.json).filter((r) => r.id != null);\nconst cards = $('Get Cards').all().map((i) => i.json).filter((r) => r.id != null);\n\n// Reinitialisation ciblee sur UN joueur (pseudo donne) plutot que tout le\n// monde : meme plan de suppression, juste filtre sur ce seul userId. Pseudo\n// introuvable -> erreur explicite plutot qu'un reset silencieux de personne.\nlet targetUserId = null;\nif (cfg.targetPseudo) {\n  const target = users.find((u) => (u.Pseudo || '').toLowerCase() === cfg.targetPseudo.toLowerCase());\n  if (!target) throw new Error('user_not_found');\n  targetUserId = target.id;\n}\nconst scoped = targetUserId != null;\n\nconst scopedPulls = scoped ? pulls.filter((p) => refId(p.User) === targetUserId) : pulls;\nconst scopedTrades = scoped ? trades.filter((t) => refId(t.FromUser) === targetUserId || refId(t.ToUser) === targetUserId) : trades;\nconst scopedQuests = scoped ? quests.filter((q) => refId(q.User) === targetUserId) : quests;\nconst scopedWeeklyQuests = scoped ? weeklyQuests.filter((q) => refId(q.User) === targetUserId) : weeklyQuests;\nconst scopedRedemptions = scoped ? redemptions.filter((r) => refId(r.User) === targetUserId) : redemptions;\nconst scopedInventory = scoped ? inventory.filter((r) => refId(r.User) === targetUserId) : inventory;\nconst scopedUsers = scoped ? users.filter((u) => u.id === targetUserId) : users;\n// Une carte dont CE joueur etait le premier obtenteur perd ce statut si on\n// efface ses tirages - mais on ne touche pas au FirstObtainedBy des autres.\nconst cardsWithFirst = cards.filter((c) => !!refId(c.FirstObtainedBy) || !!c.FirstObtainedAt);\nconst scopedCards = scoped ? cardsWithFirst.filter((c) => refId(c.FirstObtainedBy) === targetUserId) : cardsWithFirst;\n\nreturn [{ json: {\n  docId: cfg.docId,\n  scope: scoped ? 'user' : 'all',\n  targetPseudo: scoped ? cfg.targetPseudo : null,\n  pullIds: scopedPulls.map((p) => p.id),\n  tradeIds: scopedTrades.map((t) => t.id),\n  questIds: scopedQuests.map((q) => q.id),\n  weeklyQuestIds: scopedWeeklyQuests.map((q) => q.id),\n  redemptionIds: scopedRedemptions.map((r) => r.id),\n  inventoryIds: scopedInventory.map((r) => r.id),\n  userIds: scopedUsers.map((u) => u.id),\n  cardIdsToReset: scopedCards.map((c) => c.id),\n  counts: {\n    pulls: scopedPulls.length,\n    trades: scopedTrades.length,\n    quests: scopedQuests.length,\n    weeklyQuests: scopedWeeklyQuests.length,\n    redemptions: scopedRedemptions.length,\n    boosterInventory: scopedInventory.length,\n    users: scopedUsers.length,\n    cardsReset: scopedCards.length\n  }\n} }];\n"
      }
    },
