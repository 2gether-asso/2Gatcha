      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-1600, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// A adapter une seule fois : ID du document Grist + app Discord (voir README).\nconst body = $input.first().json.body || {};\nreturn [{\n  json: {\n    docId: 'cRP1WgZQv7KmwmVrUbuEF8',\n    clientId: '1551531676335870104',\n    clientSecret: 'CHANGE-MOI-DISCORD-CLIENT-SECRET',\n    redirectUri: 'https://gatcha.2gether-asso.fr/auth-callback.html',\n    guildId: '778692492644188211',\n    code: (body.code || '').toString().trim()\n  }\n}];"
      },
      "id": "set-config",
      "name": "Set Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1380, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://discord.com/api/oauth2/token",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            { "name": "client_id", "value": "={{ $json.clientId }}" },
            { "name": "client_secret", "value": "={{ $json.clientSecret }}" },
            { "name": "grant_type", "value": "authorization_code" },
            { "name": "code", "value": "={{ $json.code }}" },
            { "name": "redirect_uri", "value": "={{ $json.redirectUri }}" }
          ]
        },
        "options": {}
      },
      "id": "exchange-token",
      "name": "Exchange Token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-1160, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://discord.com/api/users/@me",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $json.access_token }}" }
          ]
        },
        "options": {}
      },
      "id": "get-discord-user",
      "name": "Get Discord User",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-940, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://discord.com/api/users/@me/guilds",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $('Exchange Token').first().json.access_token }}" }
          ]
        },
        "options": {}
      },
      "id": "get-discord-guilds",
      "name": "Get Discord Guilds",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-720, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Verifie que l'utilisateur Discord fait partie du serveur de l'asso, et\n// precalcule son avatar (avatar par defaut si aucun n'est defini).\nconst config = $('Set Config').first().json;\nconst discordUser = $('Get Discord User').first().json;\nconst guilds = $('Get Discord Guilds').all().map((i) => i.json);\nconst inGuild = guilds.some((g) => g.id === config.guildId);\n\nlet avatarUrl;\nif (discordUser.avatar) {\n  avatarUrl = `https://cdn.discordapp.com/avatars/${discordUser.id}/${discordUser.avatar}.png?size=128`;\n} else {\n  const defaultIndex = Number(BigInt(discordUser.id) >> 22n) % 6;\n  avatarUrl = `https://cdn.discordapp.com/embed/avatars/${defaultIndex}.png`;\n}\n\nreturn [{\n  json: {\n    inGuild,\n    discordId: discordUser.id,\n    discordUsername: discordUser.global_name || discordUser.username,\n    discordAvatar: avatarUrl\n  }\n}];"
      },
      "id": "check-guild",
      "name": "Check Guild Membership",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-500, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.inGuild }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-in-guild",
      "name": "If In Guild",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
