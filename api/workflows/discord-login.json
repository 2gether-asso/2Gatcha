      "id": "get-users",
      "name": "Get Users",
      "type": "n8n-nodes-base.grist",
      "typeVersion": 1,
      "position": [-60, 180],
      "alwaysOutputData": true,
      "credentials": { "gristApi": { "id": "Yoc8FS9lCXpWBRrk", "name": "Grist account" } }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const config = $('Set Config').first().json;\nconst guild = $('Check Guild Membership').first().json;\nconst users = $input.all().map((i) => i.json);\nconst match = users.find((u) => (u.DiscordId || '').toString() === guild.discordId);\n\nreturn [{\n  json: {\n    found: !!match,\n    userId: match ? match.id : null,\n    pseudo: match ? match.Pseudo : (guild.discordUsername || 'Joueur'),\n    discordId: guild.discordId,\n    discordUsername: guild.discordUsername,\n    discordAvatar: guild.discordAvatar,\n    docId: config.docId\n  }\n}];"
      },
      "id": "match-user",
      "name": "Match User",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [160, 180]
    },
    {
