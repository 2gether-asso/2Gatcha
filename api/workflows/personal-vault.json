    {
      "id": "dispatch",
      "name": "Dispatch Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Coffre-fort personnel (2026-10-02) : une fois la carte du coffre (Pepper)\n// debloquee, chaque joueur peut y mettre en securite ses cartes precieuses.\n// Une LIGNE = une carte, 6 emplacements (un par finition), parfait etat\n// uniquement. Une carte rangee reste a son proprietaire (Pulls.InVault=true,\n// numero de serie conserve) mais quitte la collection : non echangeable,\n// non decraftable... jusqu'a ce qu'il la retire (a tout moment). Ligne\n// complete = recompense UNE seule fois (table VaultRewards).\nfunction refId(v) { return Array.isArray(v) ? v[1] : v; }\nfunction firstAttachment(v) { if (!Array.isArray(v) || !v.length) return null; const ids = v[0] === 'L' ? v.slice(1) : v; return ids.length ? ids[0] : null; }\nconst cfg = $('Set Config').first().json;\nconst cards = $('Get Cards').all().map((i) => i.json).filter((r) => r.id != null);\nconst users = $('Get Users').all().map((i) => i.json).filter((r) => r.id != null);\nconst pulls = $('Get Pulls').all().map((i) => i.json).filter((r) => r.id != null);\nconst rarities = $('Get Rarities').all().map((i) => i.json).filter((r) => r.id != null);\nconst rewards = $('Get Vault Rewards').all().map((i) => i.json).filter((r) => r.id != null);\nconst configRow = $('Get Config').all().map((i) => i.json).find((r) => r.id != null);\nconst user = users.find((u) => u.id === cfg.userId);\nif (!user) return [{ json: { ...cfg, ok: false, error: 'unknown_user' } }];\n\nconst BOOSTERS_PER_ROW = (configRow && configRow.VaultBoostersPerRow) || 6;\nconst DUST_PER_ROW = (configRow && configRow.VaultDustPerRow) || 200;\nconst FINISHES = ['normal', 'holo', 'gold', 'ghost', 'diamond', 'rainbow'];\n\nconst vaultCard = cards.find((c) => !!c.IsVault);\nconst myPulls = pulls.filter((p) => refId(p.User) === cfg.userId);\nconst unlocked = !!vaultCard && myPulls.some((p) => refId(p.Card) === vaultCard.id && String(p.BatchId || '').startsWith('vault-'));\nif (!unlocked) {\n  if (cfg.action !== 'status') return [{ json: { ...cfg, ok: false, error: 'vault_locked' } }];\n  return [{ json: { ...cfg, ok: true, mutation: 'none', payload: { unlocked: false } } }];\n}\n\nconst finishOf = (p) => p.Finish || 'normal';\nconst qualityOf = (p) => p.Quality || 'damaged';\nlet mutation = 'none';\nlet target = null;\nif (cfg.action === 'store' || cfg.action === 'withdraw') {\n  target = myPulls.find((p) => p.id === cfg.pullId);\n  if (!target) return [{ json: { ...cfg, ok: false, error: 'pull_not_owned' } }];\n  if (cfg.action === 'store') {\n    if (target.InVault) return [{ json: { ...cfg, ok: false, error: 'already_stored' } }];\n    if (qualityOf(target) !== 'mint') return [{ json: { ...cfg, ok: false, error: 'not_mint' } }];\n    const taken = myPulls.some((p) => p.InVault && refId(p.Card) === refId(target.Card) && finishOf(p) === finishOf(target));\n    if (taken) return [{ json: { ...cfg, ok: false, error: 'slot_filled' } }];\n    target.InVault = true;\n  } else {\n    if (!target.InVault) return [{ json: { ...cfg, ok: false, error: 'not_stored' } }];\n    target.InVault = false;\n  }\n  mutation = 'setVault';\n}\n\nconst claimedCards = new Set(rewards.filter((r) => refId(r.User) === cfg.userId).map((r) => refId(r.Card)));\nconst rarityById = {}; rarities.forEach((r) => { rarityById[r.id] = r; });\nconst rows = cards.map((card) => {\n  const mine = myPulls.filter((p) => refId(p.Card) === card.id && qualityOf(p) === 'mint');\n  if (!mine.length && !claimedCards.has(card.id)) return null;\n  const slots = FINISHES.map((f) => {\n    const stored = mine.find((p) => p.InVault && finishOf(p) === f);\n    const candidates = mine.filter((p) => !p.InVault && finishOf(p) === f).map((p) => ({ pullId: p.id, serialNumber: p.SerialNumber }));\n    return { finish: f, stored: stored ? { pullId: stored.id, serialNumber: stored.SerialNumber } : null, candidates };\n  });\n  const rarity = rarityById[refId(card.Rarity)];\n  return {\n    cardId: card.id, name: card.Name, imageId: firstAttachment(card.Image),\n    rarity: rarity ? { key: rarity.Key, name: rarity.Name, colorHex: rarity.ColorHex, sortOrder: rarity.SortOrder || 0 } : null,\n    slots, filled: slots.filter((s) => s.stored).length,\n    complete: slots.every((s) => s.stored), claimed: claimedCards.has(card.id)\n  };\n}).filter(Boolean).sort((a, b) => (b.filled - a.filled) || ((b.rarity?.sortOrder || 0) - (a.rarity?.sortOrder || 0)) || a.name.localeCompare(b.name));\n\nlet reward = null;\nif (cfg.action === 'store') {\n  const row = rows.find((r) => r.cardId === refId(target.Card));\n  if (row && row.complete && !row.claimed) {\n    reward = { cardId: row.cardId, cardName: row.name, boosters: BOOSTERS_PER_ROW, dust: DUST_PER_ROW };\n    row.claimed = true;\n  }\n}\nconst newBoosterCount = (user.BoosterCount || 0) + (reward ? reward.boosters : 0);\nconst newStardust = (user.StardustCount || 0) + (reward ? reward.dust : 0);\nreturn [{ json: {\n  ...cfg, ok: true, mutation, grantReward: !!reward,\n  targetPullId: target ? target.id : null, targetInVault: target ? !!target.InVault : null,\n  newBoosterCount, newStardust, rewardCardId: reward ? reward.cardId : null,\n  payload: { unlocked: true, rows, boostersPerRow: BOOSTERS_PER_ROW, dustPerRow: DUST_PER_ROW, reward }\n} }];"
      },
