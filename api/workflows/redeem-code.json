    {
      "id": "decide-redemption-outcome",
      "name": "Decide Redemption Outcome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        260
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nconst prep = $('Validate & Prepare').first().json;\nconst isCard = prep.kind === 'card';\nconst myRedemptionId = $('Wait Before Recheck').first().json.myRedemptionId;\nconst codeRowId = prep.codeRowId;\nconst maxRedemptions = prep.maxRedemptions || 0;\nconst docId = prep.docId;\n\nconst allRedemptions = $('Recheck Code Redemptions').all().map((i) => i.json).filter((r) => r.id != null && refId(r.Code) === codeRowId);\nallRedemptions.sort((a, b) => a.id - b.id);\nconst winners = maxRedemptions ? allRedemptions.slice(0, maxRedemptions) : allRedemptions;\nconst iWon = !maxRedemptions || winners.some((r) => r.id === myRedemptionId);\n\nif (iWon) {\n  return [{ json: { rollback: false, isCard, docId } }];\n}\n\nif (isCard) {\n  const finalize = $('Finalize Card').first().json;\n  return [{ json: { rollback: true, isCard: true, docId, redemptionRowId: myRedemptionId, pullRowIds: finalize.pullRowIds || [] } }];\n}\nreturn [{ json: { rollback: true, isCard: false, docId, redemptionRowId: myRedemptionId, userId: prep.userId, oldBoosterCount: prep.oldBoosterCount } }];"
      }
    },
