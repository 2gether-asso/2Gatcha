      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// BUG REEL corrige ici (2026-09-30) : \"Decide Redemption Outcome\" essayait\n// de distinguer la branche carte/booster en lisant $('Insert Redemption\n// Card')/$('Insert Redemption Booster') - mais n8n leve une erreur reelle\n// des qu'on reference un noeud qui n'a PAS execute sur le chemin emprunte\n// (une seule des deux branches tourne jamais par execution), pas juste une\n// liste vide comme je l'avais suppose. On capture donc l'id de la ligne de\n// reclamation ICI (le seul point ou les deux branches se rejoignent), et on\n// determine card/booster via Validate & Prepare (qui tourne TOUJOURS) plus\n// loin plutot que via les noeuds Insert conditionnels.\nconst myRedemptionId = $input.first().json.id;\nawait new Promise((resolve) => setTimeout(resolve, 400));\nreturn [{ json: { myRedemptionId } }];"
      }
