      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cards = $('Validate & Prepare').all().map((i) => i.json).map((c) => ({\n  cardId: c.cardId,\n  name: c.name,\n  artist: c.artist,\n  description: c.description,\n  imageId: c.imageId,\n  rarity: c.rarity,\n  isFirstEver: !!c.isFirstEver,\n  serialNumber: c.serialNumber\n}));\nconst first = $('Validate & Prepare').first().json;\nconst pullRowIds = $('Insert Pulls').all().map((i) => i.json.id);\nreturn [{ json: { kind: 'card', codeRowId: first.codeRowId, userId: first.userId, docId: first.docId, maxRedemptions: first.maxRedemptions, pullRowIds, cards } }];"
