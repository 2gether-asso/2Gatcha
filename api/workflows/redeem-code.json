    {
      "id": "build-notify-payload",
      "name": "Build Notify Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        820
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const config = $('Set Config').first().json;\nconst final = $('Finalize Card').first().json;\nconst users = $('Get Users').all().map((i) => i.json).filter((r) => r.id != null);\nconst user = users.find((u) => u.id === final.userId);\nconst pseudo = (user && user.Pseudo) || 'Un joueur';\nconst discordMention = user && user.DiscordId ? `<@${user.DiscordId}>` : `**${pseudo}**`;\nfunction hexToInt(hex) { return parseInt((hex || '9aa0b4').replace('#', ''), 16) || 0x9aa0b4; }\n\nconst legendary = (final.cards || []).filter((c) => c.rarity && c.rarity.key === 'legendaire');\nconst epic = (final.cards || []).filter((c) => c.rarity && c.rarity.key === 'epique');\n\nlet content = '';\nlet embeds = [];\nif (legendary.length) {\n  content = `\\u{1F31F} ${discordMention} vient de decrocher une carte legendaire (code) !`;\n  embeds = [{ color: hexToInt(legendary[0].rarity.colorHex), title: '\\u{1F451} ' + legendary.map((c) => c.name).join(', '), description: `Rarete : **${legendary[0].rarity.name}**` }];\n} else if (epic.length) {\n  content = `\\u2728 **${pseudo}** vient d'obtenir une carte epique (code).`;\n  embeds = [{ color: hexToInt(epic[0].rarity.colorHex), title: epic.map((c) => c.name).join(', '), description: `Rarete : **${epic[0].rarity.name}**` }];\n}\n\nconst shouldNotify = (legendary.length > 0 || epic.length > 0) && !!config.discordWebhookUrl && !config.discordWebhookUrl.startsWith('CHANGE-MOI');\n\nreturn [{ json: { shouldNotify, webhookUrl: config.discordWebhookUrl, content, embeds } }];"
      }
    },
