    {
      "id": "validate-prepare",
      "name": "Validate & Prepare",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -940,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nfunction firstAttachment(v) {\n  if (!Array.isArray(v) || !v.length) return null;\n  const ids = v[0] === 'L' ? v.slice(1) : v;\n  return ids.length ? ids[0] : null;\n}\n\nconst config = $('Set Config').first().json;\nconst codesRows = $('Get Event Codes').all().map((i) => i.json).filter((r) => r.id != null);\nconst redemptionsRows = $('Get Code Redemptions').all().map((i) => i.json).filter((r) => r.id != null);\nconst cardsRows = $('Get Cards').all().map((i) => i.json).filter((r) => r.id != null);\nconst raritiesRows = $('Get Rarities').all().map((i) => i.json).filter((r) => r.id != null);\nconst usersRows = $('Get Users').all().map((i) => i.json).filter((r) => r.id != null);\nconst allPulls = $('Get All Pulls').all().map((i) => i.json).filter((r) => r.id != null);\n\nif (!config.code) {\n  return [{ json: { ok: false, error: 'invalid_code' } }];\n}\nconst normalized = config.code.toLowerCase();\nconst codeRow = codesRows.find((c) => (c.Code || '').toString().trim().toLowerCase() === normalized);\n\nif (!codeRow) {\n  return [{ json: { ok: false, error: 'invalid_code' } }];\n}\nif (codeRow.Active === false) {\n  return [{ json: { ok: false, error: 'code_inactive' } }];\n}\nconst now = Math.floor(Date.now() / 1000);\nif (codeRow.ExpiresAt && now > codeRow.ExpiresAt) {\n  return [{ json: { ok: false, error: 'code_expired' } }];\n}\n\nconst codeRedemptions = redemptionsRows.filter((r) => refId(r.Code) === codeRow.id);\nif (codeRedemptions.some((r) => refId(r.User) === config.userId)) {\n  return [{ json: { ok: false, error: 'already_redeemed' } }];\n}\nif (codeRow.MaxRedemptions && codeRedemptions.length >= codeRow.MaxRedemptions) {\n  return [{ json: { ok: false, error: 'code_exhausted' } }];\n}\n\nconst user = usersRows.find((u) => u.id === config.userId);\nif (!user) {\n  return [{ json: { ok: false, error: 'unknown_user' } }];\n}\n\nconst quantity = codeRow.Quantity || 1;\nconst batchId = `code-${codeRow.Code}-${Date.now()}`;\n\nif (codeRow.RewardType === 'card') {\n  const card = cardsRows.find((c) => c.id === refId(codeRow.CardId));\n  if (!card) {\n    return [{ json: { ok: false, error: 'code_misconfigured' } }];\n  }\n  const rarityRow = raritiesRows.find((r) => r.id === refId(card.Rarity));\n  const rarity = rarityRow ? { id: rarityRow.id, name: rarityRow.Name, key: rarityRow.Key, colorHex: rarityRow.ColorHex } : null;\n\n  // Plus de quota (Cards.MaxSerial) : un code peut toujours etre reclame.\n  // On suit QUELS numeros sont utilises (pas juste un compteur) pour\n  // reattribuer les plus petits numeros libres - un exemplaire decrafte/\n  // defausse libere vraiment son numero pour un futur don, sans jamais\n  // dupliquer un numero encore en circulation.\n  const usedSerials = new Set();\n  allPulls.forEach((p) => { if (refId(p.Card) === card.id && p.SerialNumber != null) usedSerials.add(p.SerialNumber); });\n  function takeNextSerial() {\n    for (let n = 1; ; n++) {\n      if (!usedSerials.has(n)) { usedSerials.add(n); return n; }\n    }\n  }\n\n  const maxRedemptions = codeRow.MaxRedemptions || 0;\n  const items = [];\n  for (let i = 0; i < quantity; i++) {\n    items.push({\n      json: {\n        ok: true,\n        kind: 'card',\n        docId: config.docId,\n        codeRowId: codeRow.id,\n        maxRedemptions,\n        userId: config.userId,\n        obtainedAt: now,\n        batchId,\n        cardId: card.id,\n        isFirstEver: !card.FirstObtainedBy,\n        name: card.Name,\n        artist: card.Artist,\n        description: card.Description,\n        imageId: firstAttachment(card.Image),\n        rarity,\n        serialNumber: takeNextSerial()\n      }\n    });\n  }\n  return items;\n}\n\nreturn [{\n  json: {\n    ok: true,\n    kind: 'booster',\n    docId: config.docId,\n    codeRowId: codeRow.id,\n    maxRedemptions: codeRow.MaxRedemptions || 0,\n    userId: config.userId,\n    quantity,\n    oldBoosterCount: user.BoosterCount || 0,\n    newBoosterCount: (user.BoosterCount || 0) + quantity\n  }\n}];"
      }
    },
