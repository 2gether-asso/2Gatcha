{
  "name": "2Gatcha - update-pseudo",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "update-pseudo",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-680, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// A adapter une seule fois : ID du document Grist.\nconst body = $input.first().json.body || {};\nconst pseudo = (body.pseudo || '').toString().trim().slice(0, 30);\nif (!pseudo) {\n  throw new Error('Pseudo vide');\n}\nreturn [{\n  json: {\n    docId: 'cRP1WgZQv7KmwmVrUbuEF8',\n    userId: Number(body.userId),\n    pseudo\n  }\n}];"
      },
      "id": "set-config",
      "name": "Set Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-460, 300]
    },
    {
      "parameters": {
        "operation": "update",
        "docId": "={{ $json.docId }}",
        "tableId": "Users",
        "rowId": "={{ $json.userId }}",
        "dataToSend": "defineInNode",
        "fieldsToSend": {
          "properties": [
            { "fieldId": "Pseudo", "fieldValue": "={{ $json.pseudo }}" }
          ]
        }
      },
      "id": "update-user",
      "name": "Update User",
      "type": "n8n-nodes-base.grist",
      "typeVersion": 1,
      "position": [-240, 300],
      "credentials": { "gristApi": { "id": "Yoc8FS9lCXpWBRrk", "name": "Grist account" } }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const updated = $input.first().json;\nreturn [{ json: { userId: updated.id, pseudo: updated.Pseudo } }];"
      },
      "id": "format-response",
      "name": "Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-20, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [200, 300]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Set Config", "type": "main", "index": 0 }]] },
    "Set Config": { "main": [[{ "node": "Update User", "type": "main", "index": 0 }]] },
    "Update User": { "main": [[{ "node": "Format Response", "type": "main", "index": 0 }]] },
