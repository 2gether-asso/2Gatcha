      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1400, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body = $input.first().json.body || {};\nreturn [{ json: {\n  docId: 'cRP1WgZQv7KmwmVrUbuEF8',\n  userId: Number(body.userId),\n  action: (body.action || 'status').toString()\n} }];"
      }
    },
    {
      "id": "get-cards",
