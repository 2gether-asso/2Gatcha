    },
    {
      "id": "sync-2",
      "name": "Sync Get Users -> Get Pulls",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-720, 300],
      "parameters": { "mode": "runOnceForAllItems", "jsCode": "return [{ json: {} }];" }
    },
    {
      "id": "get-pulls",
      "name": "Get Pulls",
      "type": "n8n-nodes-base.grist",
      "typeVersion": 1,
      "alwaysOutputData": true,
      "position": [-560, 300],
      "parameters": {
        "operation": "getAll",
        "docId": "={{ $('Set Config').first().json.docId }}",
        "tableId": "Pulls",
        "returnAll": true,
        "additionalOptions": {}
      },
      "credentials": { "gristApi": { "id": "Yoc8FS9lCXpWBRrk", "name": "Grist account" } }
    },
    {
      "id": "dispatch-action",
      "name": "Dispatch Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-380, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nconst cfg = $('Set Config').first().json;\nconst cards = $('Get Cards').all().map((i) => i.json).filter((r) => r.id != null);\nconst users = $('Get Users').all().map((i) => i.json).filter((r) => r.id != null);\nconst user = users.find((u) => u.id === cfg.userId);\nif (!user) return [{ json: { ...cfg, ok: false, error: 'unknown_user' } }];\n\n// Le coffre-fort abrite UNE carte precise, marquee a la main par l'admin\n// (Cards.IsVault=true, en plus de IsPromo=true) - une carte promo arc-en-ciel\n// vitrine, visible mais enfermee tant qu'on n'a pas 6 clefs secretes (meme\n// monnaie que la fouille/la roue quotidienne).\nconst vaultCard = cards.find((c) => !!c.IsVault);\nif (!vaultCard) return [{ json: { ...cfg, ok: false, error: 'vault_not_configured' } }];\n\nconst KEYS_REQUIRED = 6;\nconst pulls = $('Get Pulls').all().map((i) => i.json).filter((r) => r.id != null);\n// Pas de colonne d'etat dediee : comme secret-/craft-/dig-, on sait qu'un\n// joueur a deja ouvert le coffre s'il possede une ligne Pulls de la carte du\n// coffre avec un BatchId prefixe 'vault-'.\nconst alreadyOpened = pulls.some((p) => refId(p.User) === cfg.userId && refId(p.Card) === vaultCard.id && (p.BatchId || '').startsWith('vault-'));\n\nif (cfg.action === 'open') {\n  if (alreadyOpened) return [{ json: { ...cfg, ok: false, error: 'already_opened' } }];\n  if ((user.KeyCount || 0) < KEYS_REQUIRED) return [{ json: { ...cfg, ok: false, error: 'not_enough_keys' } }];\n  const usedSerials = new Set();\n  pulls.forEach((p) => { if (refId(p.Card) === vaultCard.id && p.SerialNumber != null) usedSerials.add(p.SerialNumber); });\n  let serialNumber = 1;\n  while (usedSerials.has(serialNumber)) serialNumber++;\n  return [{ json: {\n    ...cfg, ok: true, mutation: 'open',\n    cardId: vaultCard.id,\n    finish: 'rainbow',\n    serialNumber,\n    obtainedAt: Math.floor(Date.now() / 1000),\n    batchId: `vault-${cfg.userId}-${Date.now()}`,\n    newKeyCount: (user.KeyCount || 0) - KEYS_REQUIRED\n  } }];\n}\n\n// action === 'status' (ou toute autre valeur)\nreturn [{ json: {\n  ...cfg, ok: true, mutation: 'none',\n  cardId: vaultCard.id, keysRequired: KEYS_REQUIRED, userKeys: user.KeyCount || 0, alreadyOpened\n} }];"
      }
    },
    {
      "id": "if-ok",
      "name": "If Ok",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-180, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            { "leftValue": "={{ $json.ok }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true" } }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "respond-error",
      "name": "Respond Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [20, 500],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { error: $json.error } }}",
        "options": { "responseCode": 400 }
      }
    },
    {
      "id": "if-mutation-open",
      "name": "If Mutation Is Open",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [20, 220],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            { "leftValue": "={{ $json.mutation }}", "rightValue": "open", "operator": { "type": "string", "operation": "equals" } }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "update-user",
      "name": "Update User",
      "type": "n8n-nodes-base.grist",
      "typeVersion": 1,
      "position": [220, 140],
      "parameters": {
        "operation": "update",
        "docId": "={{ $json.docId }}",
        "tableId": "Users",
        "rowId": "={{ $json.userId }}",
        "dataToSend": "defineInNode",
        "fieldsToSend": {
          "properties": [
            { "fieldId": "KeyCount", "fieldValue": "={{ $json.newKeyCount }}" }
          ]
        }
      },
      "credentials": { "gristApi": { "id": "Yoc8FS9lCXpWBRrk", "name": "Grist account" } }
    },
    {
      "id": "sync-3",
      "name": "Sync Update User -> Create Pull",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 140],
      "parameters": { "mode": "runOnceForAllItems", "jsCode": "return [{ json: {} }];" }
    },
    {
      "id": "create-pull",
      "name": "Create Pull",
      "type": "n8n-nodes-base.grist",
      "typeVersion": 1,
      "position": [620, 140],
      "parameters": {
        "operation": "create",
        "docId": "={{ $('Dispatch Action').first().json.docId }}",
        "tableId": "Pulls",
        "dataToSend": "defineInNode",
        "fieldsToSend": {
          "properties": [
            { "fieldId": "User", "fieldValue": "={{ $('Dispatch Action').first().json.userId }}" },
            { "fieldId": "Card", "fieldValue": "={{ $('Dispatch Action').first().json.cardId }}" },
            { "fieldId": "Finish", "fieldValue": "={{ $('Dispatch Action').first().json.finish }}" },
            { "fieldId": "ObtainedAt", "fieldValue": "={{ $('Dispatch Action').first().json.obtainedAt }}" },
            { "fieldId": "BatchId", "fieldValue": "={{ $('Dispatch Action').first().json.batchId }}" },
            { "fieldId": "SerialNumber", "fieldValue": "={{ $('Dispatch Action').first().json.serialNumber }}" }
          ]
        }
      },
      "credentials": { "gristApi": { "id": "Yoc8FS9lCXpWBRrk", "name": "Grist account" } }
    },
    {
      "id": "format-open-response",
      "name": "Format Open Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [820, 140],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function firstAttachment(v) { if (!Array.isArray(v) || !v.length) return null; const ids = v[0] === 'L' ? v.slice(1) : v; return ids.length ? ids[0] : null; }\nconst d = $('Dispatch Action').first().json;\nconst cards = $('Get Cards').all().map((i) => i.json).filter((r) => r.id != null);\nconst card = cards.find((c) => c.id === d.cardId);\nreturn [{ json: {\n  opened: true,\n  card: { cardId: card.id, name: card.Name, artist: card.Artist, imageId: firstAttachment(card.Image), finish: 'rainbow' },\n  serialNumber: d.serialNumber,\n  newKeyCount: d.newKeyCount\n} }];"
      }
    },
    {
      "id": "format-status-response",
      "name": "Format Status Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 380],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function firstAttachment(v) { if (!Array.isArray(v) || !v.length) return null; const ids = v[0] === 'L' ? v.slice(1) : v; return ids.length ? ids[0] : null; }\nconst d = $('Dispatch Action').first().json;\nconst cards = $('Get Cards').all().map((i) => i.json).filter((r) => r.id != null);\nconst card = cards.find((c) => c.id === d.cardId);\nreturn [{ json: {\n  card: card ? { cardId: card.id, name: card.Name, artist: card.Artist, imageId: firstAttachment(card.Image) } : null,\n  keysRequired: d.keysRequired,\n  userKeys: d.userKeys,\n  alreadyOpened: d.alreadyOpened\n} }];"
      }
    },
    {
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1020, 260],
      "parameters": { "respondWith": "json", "responseBody": "={{ $json }}", "options": {} }
    }
  ],
  "connections": {
