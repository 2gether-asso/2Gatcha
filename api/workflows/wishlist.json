        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nconst cfg = $('Set Config').first().json;\nconst rows = $('Get Wishlist').all().map((i) => i.json).filter((r) => r.id != null);\nconst mine = rows.filter((r) => refId(r.User) === cfg.userId);\nconst existing = mine.find((r) => refId(r.Card) === cfg.cardId);\nreturn [{ json: { ...cfg, existingRowId: existing ? existing.id : null, alreadyPresent: !!existing } }];"
      }
    },
