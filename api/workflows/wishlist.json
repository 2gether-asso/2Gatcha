    {
      "id": "format-list",
      "name": "Format List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        180,
        540
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nfunction firstAttachment(v) {\n  if (!Array.isArray(v) || !v.length) return null;\n  const ids = v[0] === 'L' ? v.slice(1) : v;\n  return ids.length ? ids[0] : null;\n}\nconst cfg = $('Set Config').first().json;\nlet rows = $('Get Wishlist').all().map((i) => i.json).filter((r) => r.id != null && refId(r.User) === cfg.userId);\n// Get Wishlist a ete recupere AVANT la creation/suppression eventuelle plus\n// haut dans le flux (meme execution) : simuler la mutation en memoire ici\n// evite de repartir chercher Grist, et la reponse d'un add/remove refletera\n// enfin l'etat REEL juste apres l'action plutot que l'etat d'avant.\nif (cfg.action === 'add') {\n  const already = rows.some((r) => refId(r.Card) === cfg.cardId);\n  if (!already) rows.push({ id: -1, User: cfg.userId, Card: cfg.cardId });\n} else if (cfg.action === 'remove') {\n  rows = rows.filter((r) => refId(r.Card) !== cfg.cardId);\n}\nconst cards = $('Get Cards').all().map((i) => i.json).filter((r) => r.id != null);\nconst rarities = $('Get Rarities').all().map((i) => i.json).filter((r) => r.id != null);\nconst cardById = {}; cards.forEach((c) => { cardById[c.id] = c; });\nconst rarityById = {}; rarities.forEach((r) => { rarityById[r.id] = r; });\n\nconst list = rows.map((r) => {\n  const card = cardById[refId(r.Card)];\n  if (!card) return null;\n  const rarity = rarityById[refId(card.Rarity)];\n  return {\n    cardId: card.id,\n    name: card.Name,\n    imageId: firstAttachment(card.Image),\n    rarity: rarity ? { key: rarity.Key, name: rarity.Name, colorHex: rarity.ColorHex } : null\n  };\n}).filter(Boolean);\n\nreturn [{ json: { wishlist: list } }];"
      }
    },
