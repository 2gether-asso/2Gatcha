    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cfg = $('Set Config').first().json;\nfunction randomCode() {\n  const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';\n  let s = '';\n  for (let i = 0; i < 8; i++) s += chars[Math.floor(Math.random() * chars.length)];\n  return s;\n}\nconst code = (cfg.code || '').toString().trim().toUpperCase() || randomCode();\nconst now = Math.floor(Date.now() / 1000);\nconst expiresInHours = Number(cfg.expiresInHours) || 4;\nconst quantity = Number(cfg.quantity) || 1;\n\nreturn [{\n  json: {\n    docId: cfg.docId,\n    code,\n    label: cfg.label || '',\n    rewardType: cfg.rewardType === 'card' ? 'card' : 'booster',\n    quantity,\n    cardId: cfg.rewardType === 'card' ? (Number(cfg.cardId) || 0) : 0,\n    maxRedemptions: Number(cfg.maxRedemptions) || 0,\n    expiresAt: now + expiresInHours * 3600,\n    createdAt: now,\n    createdBy: cfg.discordId\n  }\n}];"
      },
