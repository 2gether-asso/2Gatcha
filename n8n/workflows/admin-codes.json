    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nconst now = Math.floor(Date.now() / 1000);\nconst codes = $('List Get Codes').all().map((i) => i.json).filter((r) => r.id != null);\nconst redemptions = $('List Get Redemptions').all().map((i) => i.json).filter((r) => r.id != null);\n\nconst list = codes.map((c) => {\n  const used = redemptions.filter((r) => refId(r.Code) === c.id).length;\n  let status = 'active';\n  if (c.Active === false) status = 'disabled';\n  else if (c.ExpiresAt && now > c.ExpiresAt) status = 'expired';\n  else if (c.MaxRedemptions && used >= c.MaxRedemptions) status = 'exhausted';\n  return {\n    code: c.Code,\n    label: c.Label,\n    rewardType: c.RewardType,\n    quantity: c.Quantity,\n    cardId: refId(c.CardId) || null,\n    maxRedemptions: c.MaxRedemptions,\n    used,\n    expiresAt: c.ExpiresAt,\n    active: c.Active !== false,\n    status,\n    createdAt: c.CreatedAt,\n    createdBy: c.CreatedBy\n  };\n}).sort((a, b) => (b.createdAt || 0) - (a.createdAt || 0));\n\nreturn [{ json: { codes: list } }];"
      },
