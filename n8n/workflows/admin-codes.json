      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// A adapter une seule fois : ID du document Grist + ID(s) Discord autorises\n// a administrer les codes (voir README, section admin), + webhook Discord\n// optionnel (case a cocher a la creation d'un code, voir admin.html).\nconst discordWebhookUrl = 'https://discord.com/api/webhooks/1551618475179511940/BsIPFGMDe0jiylrnEGTluRaPCP3zEi2tEWangoaZHgT_uShe2Zyy4dgTIRkLRjQ1cxZW';\nconst body = $input.first().json.body || {};\nconst adminDiscordIds = ['785223211730075709', '184008667690041345'];\nconst discordId = (body.discordId || '').toString();\n\nreturn [{\n  json: {\n    docId: 'cRP1WgZQv7KmwmVrUbuEF8',\n    discordWebhookUrl,\n    discordId,\n    isAdmin: adminDiscordIds.includes(discordId),\n    action: (body.action || '').toString(),\n    code: body.code,\n    label: body.label,\n    rewardType: body.rewardType,\n    quantity: body.quantity,\n    cardId: body.cardId,\n    expiresInHours: body.expiresInHours,\n    maxRedemptions: body.maxRedemptions,\n    notifyDiscord: !!body.notifyDiscord\n  }\n}];"
