        "jsCode": "// A adapter une seule fois : ID du document Grist + ID(s) Discord autorises\n// a administrer les codes (voir README, section admin).\nconst body = $input.first().json.body || {};\nconst adminDiscordIds = ['785223211730075709'];\nconst discordId = (body.discordId || '').toString();\n\nreturn [{\n  json: {\n    docId: 'cRP1WgZQv7KmwmVrUbuEF8',\n    discordId,\n    isAdmin: adminDiscordIds.includes(discordId),\n    action: (body.action || '').toString(),\n    code: body.code,\n    label: body.label,\n    rewardType: body.rewardType,\n    quantity: body.quantity,\n    cardId: body.cardId,\n    expiresInHours: body.expiresInHours,\n    maxRedemptions: body.maxRedemptions\n  }\n}];"
