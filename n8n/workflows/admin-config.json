    {
      "id": "build-update",
      "name": "Build Update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -620,
        240
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nconst config = $('Set Config').first().json;\nconst configRow = $('Get Config').all().map((i) => i.json).find((r) => r.id != null);\nif (!configRow) throw new Error('Table Config vide : ajoute une ligne de parametres dans Grist.');\nconst rarities = $('Get Rarities').all().map((i) => i.json).filter((r) => r.id != null);\n\nlet pityThreshold = configRow.PityThreshold || 0;\nif (config.pityThreshold != null && config.pityThreshold !== '') {\n  const n = Number(config.pityThreshold);\n  if (!Number.isFinite(n) || n < 1) throw new Error('pityThreshold invalide.');\n  pityThreshold = n;\n}\n\nlet topRarityId = refId(configRow.TopRarity);\nif (config.topRarityKey) {\n  const rarity = rarities.find((r) => r.Key === config.topRarityKey);\n  if (!rarity) throw new Error('Rarete inconnue: ' + config.topRarityKey);\n  topRarityId = rarity.id;\n}\n\nreturn [{ json: { rowId: configRow.id, pityThreshold, topRarityId } }];"
      }
    },
