    {
      "id": "format-response",
      "name": "Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -260,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nconst rarities = $('Get Rarities').all().map((i) => i.json).filter((r) => r.id != null);\nconst isSet = $('Set Config').first().json.action === 'set';\n\nlet pityThreshold, topRarityId;\nif (isSet) {\n  const built = $('Build Update').first().json;\n  pityThreshold = built.pityThreshold;\n  topRarityId = built.topRarityId;\n} else {\n  const configRow = $('Get Config').all().map((i) => i.json).find((r) => r.id != null);\n  if (!configRow) throw new Error('Table Config vide.');\n  pityThreshold = configRow.PityThreshold || 0;\n  topRarityId = refId(configRow.TopRarity);\n}\nconst topRarity = rarities.find((r) => r.id === topRarityId);\n\nreturn [{ json: {\n  pityThreshold,\n  topRarity: topRarity ? { id: topRarity.id, key: topRarity.Key, name: topRarity.Name } : null,\n  rarities: rarities.sort((a, b) => (a.SortOrder || 0) - (b.SortOrder || 0)).map((r) => ({ id: r.id, key: r.Key, name: r.Name }))\n} }];"
      }
    },
