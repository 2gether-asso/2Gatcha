      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const c = $('Set Config').first().json;\nconst rows = $input.all().map((i) => i.json).filter((r) => r.id != null);\nconst row = rows.find((r) => r.id === Number(c.extensionId));\nif (!row) throw new Error('Extension introuvable: ' + c.extensionId);\n\nreturn [{ json: {\n  rowId: row.id,\n  name: c.name != null && c.name !== '' ? c.name : row.Name,\n  key: c.key != null && c.key !== '' ? c.key : row.Key,\n  sortOrder: c.sortOrder != null && c.sortOrder !== '' ? Number(c.sortOrder) : (row.SortOrder || 0),\n  active: c.active != null ? !!c.active : (row.Active !== false)\n} }];"
      }
