      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Memes ID admin que admin-codes.json / admin-config.json.\nconst body = $input.first().json.body || {};\nconst adminDiscordIds = ['785223211730075709', '184008667690041345'];\nconst discordId = (body.discordId || '').toString();\n\nreturn [{\n  json: {\n    docId: 'cRP1WgZQv7KmwmVrUbuEF8',\n    discordId,\n    isAdmin: adminDiscordIds.includes(discordId),\n    action: (body.action || '').toString(),\n    extensionId: body.extensionId,\n    name: body.name,\n    key: body.key,\n    sortOrder: body.sortOrder,\n    active: body.active\n  }\n}];"
      }
    },
