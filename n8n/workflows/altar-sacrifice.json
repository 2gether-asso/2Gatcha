    {
      "id": "format-response",
      "name": "Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r = $('Compute Sacrifice').first().json;\nif (!r.success) return [{ json: { success: false } }];\nconst cards = $('Get Cards').all().map((i) => i.json).filter((c) => c.id != null);\nconst rarities = $('Get Rarities').all().map((i) => i.json).filter((rr) => rr.id != null);\nfunction refId(v) { return Array.isArray(v) ? v[1] : v; }\nconst card = cards.find((c) => c.id === r.newCardId);\nconst rarity = card ? rarities.find((rr) => rr.id === refId(card.Rarity)) : null;\nreturn [{ json: {\n  success: true,\n  isFirstEver: r.isFirstEver,\n  card: card ? {\n    cardId: card.id, name: card.Name, artist: card.Artist,\n    rarity: rarity ? { key: rarity.Key, name: rarity.Name, colorHex: rarity.ColorHex } : null\n  } : null\n} }];"
