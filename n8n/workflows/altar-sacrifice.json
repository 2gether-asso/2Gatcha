        "jsCode": "const body = $input.first().json.body || {};\nreturn [{ json: {\n  docId: 'cRP1WgZQv7KmwmVrUbuEF8',\n  userId: Number(body.userId),\n  // Le joueur choisit lui-meme parmi ses doublons lesquelles sacrifier (pas\n  // de selection au hasard cote serveur) : 3 cardId, doublons possibles si\n  // il sacrifie plusieurs exemplaires de la meme carte.\n  cardIds: Array.isArray(body.cardIds) ? body.cardIds.map(Number).filter((n) => Number.isFinite(n)) : []\n} }];"
