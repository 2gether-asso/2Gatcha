    {
      "id": "compute-sacrifice",
      "name": "Compute Sacrifice",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -900,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nconst cfg = $('Set Config').first().json;\nconst allPulls = $('Get Pulls').all().map((i) => i.json).filter((r) => r.id != null);\nconst pulls = allPulls.filter((r) => refId(r.User) === cfg.userId);\nconst cards = $('Get Cards').all().map((i) => i.json).filter((r) => r.id != null);\nconst rarities = $('Get Rarities').all().map((i) => i.json).filter((r) => r.id != null);\nconst cardById = {}; cards.forEach((c) => { cardById[c.id] = c; });\nconst rarityById = {}; rarities.forEach((r) => { rarityById[r.id] = r; });\n// Compteur global d'exemplaires par carte (toutes epoques, tous joueurs) :\n// sert a la fois a exclure les cartes epuisees du tirage et a numeroter le\n// nouvel exemplaire (Cards.MaxSerial, 100 par defaut).\nconst countByCard = {}; allPulls.forEach((p) => { const cid = refId(p.Card); countByCard[cid] = (countByCard[cid] || 0) + 1; });\n\n// Le joueur choisit lui-meme, parmi ses doublons, les 3 exemplaires a\n// sacrifier (memes cardId repetes possibles pour en sacrifier plusieurs\n// exemplaires de la meme carte).\nif (!Array.isArray(cfg.cardIds) || cfg.cardIds.length !== 3) {\n  return [{ json: { ok: false, error: 'invalid_selection' } }];\n}\n\nconst requestedCounts = {};\ncfg.cardIds.forEach((id) => { requestedCounts[id] = (requestedCounts[id] || 0) + 1; });\n\nlet sourceRarity = null;\nfor (const cardIdStr of Object.keys(requestedCounts)) {\n  const card = cardById[Number(cardIdStr)];\n  if (!card || card.IsPromo) return [{ json: { ok: false, error: 'invalid_selection' } }];\n  const rarity = rarityById[refId(card.Rarity)];\n  if (!rarity) return [{ json: { ok: false, error: 'invalid_selection' } }];\n  if (!sourceRarity) sourceRarity = rarity;\n  else if (rarity.id !== sourceRarity.id) return [{ json: { ok: false, error: 'mixed_rarity' } }];\n}\n\n// Rareté immediatement au-dessus (par SortOrder), pas de palier au-dessus de\n// la plus haute rareté existante.\nconst higher = rarities\n  .filter((r) => (r.SortOrder || 0) > (sourceRarity.SortOrder || 0))\n  .sort((a, b) => (a.SortOrder || 0) - (b.SortOrder || 0))[0];\nif (!higher) return [{ json: { ok: false, error: 'no_higher_tier' } }];\n\n// On garde toujours au moins 1 exemplaire de chaque carte sacrifiee : seuls\n// les VRAIS doublons (au-dela du premier) sont sacrifiables.\nconst pullIdsToDelete = [];\nfor (const [cardIdStr, count] of Object.entries(requestedCounts)) {\n  const cardId = Number(cardIdStr);\n  const ownedPulls = pulls.filter((p) => refId(p.Card) === cardId);\n  if (ownedPulls.length - 1 < count) return [{ json: { ok: false, error: 'not_enough_duplicates' } }];\n  pullIdsToDelete.push(...ownedPulls.slice(0, count).map((p) => p.id));\n}\n\n// 50% de reussite, quelle que soit la rareté de depart (annonce faite au\n// joueur) - meme risque a chaque palier.\nconst success = Math.random() < 0.5;\n\nlet newCard = null;\nif (success) {\n  // Exclut les cartes deja epuisees (Cards.MaxSerial atteint) du tirage de\n  // la rarete superieure.\n  const candidates = cards.filter((c) => c.Active !== false && !c.IsPromo && refId(c.Rarity) === higher.id && (countByCard[c.id] || 0) < (c.MaxSerial || 100));\n  if (!candidates.length) return [{ json: { ok: false, error: 'no_target_card' } }];\n  const picked = candidates[Math.floor(Math.random() * candidates.length)];\n  const maxSerial = picked.MaxSerial || 100;\n  newCard = {\n    cardId: picked.id,\n    name: picked.Name,\n    isFirstEver: !refId(picked.FirstObtainedBy),\n    serialNumber: (countByCard[picked.id] || 0) + 1,\n    maxSerial\n  };\n}\n\nreturn [{ json: {\n  ok: true,\n  docId: cfg.docId,\n  userId: cfg.userId,\n  pullIdsToDelete,\n  success,\n  newCardId: newCard ? newCard.cardId : null,\n  isFirstEver: newCard ? newCard.isFirstEver : false,\n  serialNumber: newCard ? newCard.serialNumber : null,\n  maxSerial: newCard ? newCard.maxSerial : null\n} }];"
      }
