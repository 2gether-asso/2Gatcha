    {
      "id": "compute-sacrifice",
      "name": "Compute Sacrifice",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -900,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nconst cfg = $('Set Config').first().json;\nconst pulls = $('Get Pulls').all().map((i) => i.json).filter((r) => r.id != null && refId(r.User) === cfg.userId);\nconst cards = $('Get Cards').all().map((i) => i.json).filter((r) => r.id != null);\nconst rarities = $('Get Rarities').all().map((i) => i.json).filter((r) => r.id != null);\nconst cardById = {}; cards.forEach((c) => { cardById[c.id] = c; });\n\nconst sourceRarity = rarities.find((r) => r.Key === cfg.rarityKey);\nif (!sourceRarity) return [{ json: { ok: false, error: 'invalid_rarity' } }];\n\n// Rareté immediatement au-dessus (par SortOrder), pas de palier au-dessus de\n// la plus haute rareté existante.\nconst higher = rarities\n  .filter((r) => (r.SortOrder || 0) > (sourceRarity.SortOrder || 0))\n  .sort((a, b) => (a.SortOrder || 0) - (b.SortOrder || 0))[0];\nif (!higher) return [{ json: { ok: false, error: 'no_higher_tier' } }];\n\n// N'importe quelles 3 cartes non-promo de cette rarete (pas forcement la\n// meme carte repetee) : ce sont des \"matieres premieres\", pas des exemplaires\n// precis.\nconst eligiblePulls = pulls.filter((p) => {\n  const card = cardById[refId(p.Card)];\n  return card && !card.IsPromo && refId(card.Rarity) === sourceRarity.id;\n});\nif (eligiblePulls.length < 3) return [{ json: { ok: false, error: 'not_enough_cards' } }];\n\nconst pullIdsToDelete = eligiblePulls.slice(0, 3).map((p) => p.id);\n\n// 50% de reussite, quelle que soit la rareté de depart (annonce faite au\n// joueur) - meme risque a chaque palier.\nconst success = Math.random() < 0.5;\n\nlet newCard = null;\nif (success) {\n  const candidates = cards.filter((c) => c.Active !== false && !c.IsPromo && refId(c.Rarity) === higher.id);\n  if (!candidates.length) return [{ json: { ok: false, error: 'no_target_card' } }];\n  const picked = candidates[Math.floor(Math.random() * candidates.length)];\n  newCard = {\n    cardId: picked.id,\n    name: picked.Name,\n    isFirstEver: !refId(picked.FirstObtainedBy)\n  };\n}\n\nreturn [{ json: {\n  ok: true,\n  docId: cfg.docId,\n  userId: cfg.userId,\n  pullIdsToDelete,\n  success,\n  newCardId: newCard ? newCard.cardId : null,\n  isFirstEver: newCard ? newCard.isFirstEver : false\n} }];"
      }
    },
