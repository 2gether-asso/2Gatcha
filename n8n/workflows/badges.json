    {
      "id": "format-list",
      "name": "Format List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nfunction firstAttachment(v) { if (!Array.isArray(v) || !v.length) return null; const ids = v[0] === 'L' ? v.slice(1) : v; return ids.length ? ids[0] : null; }\n// Icon peut etre soit un simple texte (emoji) soit une piece jointe Grist\n// (image uploadee) selon comment la colonne a ete remplie - on gere les deux.\nfunction iconTextOf(v) { return Array.isArray(v) ? null : (v || null); }\nfunction iconImageOf(v) { return Array.isArray(v) ? firstAttachment(v) : null; }\nconst cfg = $('Dispatch Action').first().json;\nconst catalog = $('Get Badge Catalog').all().map((i) => i.json).filter((r) => r.id != null);\nlet ownedKeys = new Set($('Get User Badges').all().map((i) => i.json).filter((r) => r.id != null && refId(r.User) === cfg.userId).map((b) => b.BadgeKey));\nconst users = $('Get Users').all().map((i) => i.json).filter((r) => r.id != null);\nlet selectedBadge = (users.find((u) => u.id === cfg.userId) || {}).SelectedBadge || null;\n\n// Simule la mutation en memoire (comme showcase.json) pour que la reponse\n// reflete l'etat REEL juste apres l'action, sans un second aller-retour Grist.\nif (cfg.mutation === 'buy') ownedKeys.add(cfg.badgeKey);\nif (cfg.mutation === 'select') selectedBadge = cfg.badgeKey;\n\nconst badges = catalog.map((b) => ({\n  key: b.Key,\n  name: b.Name,\n  description: b.Description,\n  icon: iconTextOf(b.Icon),\n  iconImageId: iconImageOf(b.Icon),\n  dustCost: b.DustCost || 0,\n  owned: ownedKeys.has(b.Key),\n  selected: selectedBadge === b.Key\n})).sort((a, b) => a.dustCost - b.dustCost);\n\nreturn [{ json: { badges, selectedBadge, newStardust: cfg.mutation === 'buy' ? cfg.newStardust : undefined } }];"
      }
    },
