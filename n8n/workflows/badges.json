    {
      "id": "dispatch",
      "name": "Dispatch Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -340,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nconst cfg = $('Set Config').first().json;\nconst catalog = $('Get Badge Catalog').all().map((i) => i.json).filter((r) => r.id != null);\nconst myBadges = $('Get User Badges').all().map((i) => i.json).filter((r) => r.id != null && refId(r.User) === cfg.userId);\nconst users = $('Get Users').all().map((i) => i.json).filter((r) => r.id != null);\nconst user = users.find((u) => u.id === cfg.userId);\nconst ownedKeys = new Set(myBadges.map((b) => b.BadgeKey));\n\nif (cfg.action === 'buy') {\n  const badge = catalog.find((b) => b.Key === cfg.badgeKey);\n  if (!badge) return [{ json: { ...cfg, ok: false, error: 'badge_not_found' } }];\n  if (ownedKeys.has(cfg.badgeKey)) return [{ json: { ...cfg, ok: true, mutation: 'none' } }];\n  const cost = badge.DustCost || 0;\n  if ((user.StardustCount || 0) < cost) return [{ json: { ...cfg, ok: false, error: 'insufficient_dust' } }];\n  return [{ json: { ...cfg, ok: true, mutation: 'buy', cost, newStardust: (user.StardustCount || 0) - cost } }];\n}\nif (cfg.action === 'select') {\n  const badge = catalog.find((b) => b.Key === cfg.badgeKey);\n  if (!badge) return [{ json: { ...cfg, ok: false, error: 'badge_not_found' } }];\n  if (!ownedKeys.has(cfg.badgeKey)) return [{ json: { ...cfg, ok: false, error: 'badge_not_owned' } }];\n  if (user.SelectedBadge === cfg.badgeKey) return [{ json: { ...cfg, ok: true, mutation: 'none' } }];\n  return [{ json: { ...cfg, ok: true, mutation: 'select' } }];\n}\n// action === 'list' (ou toute autre valeur) : aucune mutation.\nreturn [{ json: { ...cfg, ok: true, mutation: 'none' } }];"
      }
    },
