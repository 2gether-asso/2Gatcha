    {
      "id": "dispatch",
      "name": "Dispatch Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 400],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nfunction refIdList(v) { if (!Array.isArray(v)) return []; return v[0] === 'L' ? v.slice(1) : v; }\nfunction firstAttachment(v) { if (!Array.isArray(v) || !v.length) return null; const ids = v[0] === 'L' ? v.slice(1) : v; return ids.length ? ids[0] : null; }\nconst cfg = $('Set Config').first().json;\nconst grids = $('Get Bingo Grids').all().map((i) => i.json).filter((r) => r.id != null);\nconst claims = $('Get Bingo Claims').all().map((i) => i.json).filter((r) => r.id != null);\nconst pulls = $('Get Pulls').all().map((i) => i.json).filter((r) => r.id != null && refId(r.User) === cfg.userId);\nconst cards = $('Get Cards').all().map((i) => i.json).filter((r) => r.id != null);\nconst rarities = $('Get Rarities').all().map((i) => i.json).filter((r) => r.id != null);\nconst users = $('Get Users').all().map((i) => i.json).filter((r) => r.id != null);\nconst cardById = {}; cards.forEach((c) => { cardById[c.id] = c; });\nconst rarityById = {}; rarities.forEach((r) => { rarityById[r.id] = r; });\nconst ownedCardIds = new Set(pulls.map((p) => refId(p.Card)));\n\nif (cfg.action === 'adminSetGrid') {\n  if (!cfg.isAdmin) return [{ json: { ...cfg, ok: false, error: 'forbidden' } }];\n  if (cfg.cardIds.length !== 9) return [{ json: { ...cfg, ok: false, error: 'grid_needs_9_cards' } }];\n  const existing = grids.find((g) => g.Month === cfg.month);\n  return [{ json: { ...cfg, ok: true, mutation: 'adminSetGrid', gridExists: !!existing, existingRowId: existing ? existing.id : null } }];\n}\n\nconst grid = grids.find((g) => g.Month === cfg.currentMonth);\nif (!grid) {\n  if (cfg.action === 'claim') return [{ json: { ...cfg, ok: false, error: 'no_grid_this_month' } }];\n  return [{ json: { ...cfg, ok: true, mutation: 'none', hasGrid: false } }];\n}\nconst gridCardIds = refIdList(grid.CardIds);\nconst cells = gridCardIds.map((cid) => {\n  const card = cardById[cid];\n  if (!card) return null;\n  const rarity = rarityById[refId(card.Rarity)];\n  return { cardId: card.id, name: card.Name, imageId: firstAttachment(card.Image), rarity: rarity ? { key: rarity.Key, name: rarity.Name, colorHex: rarity.ColorHex } : null, owned: ownedCardIds.has(cid) };\n}).filter(Boolean);\nconst allOwned = cells.length === 9 && cells.every((c) => c.owned);\nconst alreadyClaimed = claims.some((c) => refId(c.User) === cfg.userId && c.Month === cfg.currentMonth);\n\nif (cfg.action === 'claim') {\n  if (!allOwned) return [{ json: { ...cfg, ok: false, error: 'grid_not_complete' } }];\n  if (alreadyClaimed) return [{ json: { ...cfg, ok: false, error: 'already_claimed' } }];\n  const user = users.find((u) => u.id === cfg.userId);\n  return [{ json: { ...cfg, ok: true, mutation: 'claim', rewardBoosters: grid.RewardBoosters || 0, newBoosterCount: (user ? (user.BoosterCount || 0) : 0) + (grid.RewardBoosters || 0) } }];\n}\n\n// action === 'status' (ou toute autre valeur) : aucune mutation.\nreturn [{ json: { ...cfg, ok: true, mutation: 'none', hasGrid: true, month: cfg.currentMonth, cells, allOwned, claimed: alreadyClaimed } }];"
      }
    },
