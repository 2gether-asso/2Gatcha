      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1580, 400],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const adminDiscordIds = ['785223211730075709', '184008667690041345'];\nconst body = $input.first().json.body || {};\nconst discordId = (body.discordId || '').toString();\nconst month = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Paris' }).format(new Date()).slice(0, 7);\nreturn [{ json: {\n  docId: 'cRP1WgZQv7KmwmVrUbuEF8',\n  userId: Number(body.userId),\n  action: (body.action || '').toString(),\n  discordId,\n  isAdmin: adminDiscordIds.includes(discordId),\n  month: (body.month || month).toString(),\n  currentMonth: month,\n  cardIds: Array.isArray(body.cardIds) ? body.cardIds.map(Number).filter((n) => Number.isFinite(n)) : [],\n  rewardBoosters: Number(body.rewardBoosters) || 0\n} }];"
