        "mode": "runOnceForAllItems",
        "jsCode": "const adminDiscordIds = ['785223211730075709', '184008667690041345'];\nconst body = $input.first().json.body || {};\nconst discordId = (body.discordId || '').toString();\nreturn [{ json: {\n  docId: 'cRP1WgZQv7KmwmVrUbuEF8',\n  userId: Number(body.userId),\n  action: (body.action || '').toString(),\n  offerId: Number(body.offerId),\n  discordId,\n  isAdmin: adminDiscordIds.includes(discordId),\n  cardId: Number(body.cardId),\n  cost: Number(body.cost) || 0,\n  expiresInHours: Number(body.expiresInHours) || 24,\n  maxPurchases: Number(body.maxPurchases) || 0\n} }];"
