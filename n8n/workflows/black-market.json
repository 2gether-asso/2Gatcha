    {
      "id": "dispatch",
      "name": "Dispatch Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [120, 400],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nfunction firstAttachment(v) { if (!Array.isArray(v) || !v.length) return null; const ids = v[0] === 'L' ? v.slice(1) : v; return ids.length ? ids[0] : null; }\nconst cfg = $('Set Config').first().json;\nconst now = Math.floor(Date.now() / 1000);\nconst offersRows = $('Get Black Market Offers').all().map((i) => i.json).filter((r) => r.id != null);\nconst pulls = $('Get Pulls').all().map((i) => i.json).filter((r) => r.id != null);\nconst cards = $('Get Cards').all().map((i) => i.json).filter((r) => r.id != null);\nconst rarities = $('Get Rarities').all().map((i) => i.json).filter((r) => r.id != null);\nconst users = $('Get Users').all().map((i) => i.json).filter((r) => r.id != null);\nconst cardById = {}; cards.forEach((c) => { cardById[c.id] = c; });\nconst rarityById = {}; rarities.forEach((r) => { rarityById[r.id] = r; });\n\nfunction purchasesFor(offerId) {\n  const prefix = `market-${offerId}-`;\n  return pulls.filter((p) => (p.BatchId || '').toString().startsWith(prefix)).length;\n}\n\nif (cfg.action === 'buy') {\n  const offer = offersRows.find((o) => o.id === cfg.offerId);\n  if (!offer) return [{ json: { ...cfg, ok: false, error: 'offer_not_found' } }];\n  if (offer.Active === false) return [{ json: { ...cfg, ok: false, error: 'offer_inactive' } }];\n  if (offer.ExpiresAt && now > offer.ExpiresAt) return [{ json: { ...cfg, ok: false, error: 'offer_expired' } }];\n  const used = purchasesFor(offer.id);\n  if (offer.MaxPurchases && used >= offer.MaxPurchases) return [{ json: { ...cfg, ok: false, error: 'offer_exhausted' } }];\n  const user = users.find((u) => u.id === cfg.userId);\n  const cost = offer.Cost || 0;\n  if (!user || (user.StardustCount || 0) < cost) return [{ json: { ...cfg, ok: false, error: 'insufficient_dust' } }];\n  const cardId = refId(offer.CardId);\n  const card = cardById[cardId];\n  if (!card) return [{ json: { ...cfg, ok: false, error: 'card_not_found' } }];\n  const existingCount = pulls.filter((p) => refId(p.Card) === cardId).length;\n  const maxSerial = card.MaxSerial || 100;\n  if (existingCount >= maxSerial) return [{ json: { ...cfg, ok: false, error: 'sold_out' } }];\n  return [{ json: {\n    ...cfg, ok: true, mutation: 'buy',\n    offerRowId: offer.id, cardId, cost, newStardust: (user.StardustCount || 0) - cost,\n    batchId: `market-${offer.id}-${cfg.userId}-${Date.now()}`,\n    serialNumber: existingCount + 1, maxSerial\n  } }];\n}\n\nif (cfg.action === 'adminCreate') {\n  if (!cfg.isAdmin) return [{ json: { ...cfg, ok: false, error: 'forbidden' } }];\n  const card = cardById[cfg.cardId];\n  if (!card || !cfg.cost) return [{ json: { ...cfg, ok: false, error: 'missing_fields' } }];\n  return [{ json: { ...cfg, ok: true, mutation: 'adminCreate', expiresAt: now + cfg.expiresInHours * 3600 } }];\n}\n\n// action === 'list' (ou toute autre valeur) : aucune mutation.\nconst list = offersRows\n  .filter((o) => o.Active !== false && (!o.ExpiresAt || now < o.ExpiresAt))\n  .map((o) => {\n    const cardId = refId(o.CardId);\n    const card = cardById[cardId];\n    const rarity = card ? rarityById[refId(card.Rarity)] : null;\n    const used = purchasesFor(o.id);\n    const remaining = o.MaxPurchases ? Math.max(0, o.MaxPurchases - used) : null;\n    return card ? {\n      offerId: o.id, cost: o.Cost || 0, expiresAt: o.ExpiresAt || null, remaining,\n      card: { cardId: card.id, name: card.Name, artist: card.Artist, imageId: firstAttachment(card.Image), rarity: rarity ? { key: rarity.Key, name: rarity.Name, colorHex: rarity.ColorHex } : null }\n    } : null;\n  }).filter((o) => o && (o.remaining === null || o.remaining > 0));\nreturn [{ json: { ...cfg, ok: true, mutation: 'none', offers: list } }];"
      }
    },
