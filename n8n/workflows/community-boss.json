    {
      "id": "expand-contributors",
      "name": "Expand Contributors For Reward",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1900,
        -40
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nconst d = $('Dispatch Action').first().json;\nconst contributions = $('Get Boss Contributions').all().map((i) => i.json).filter((r) => r.id != null && refId(r.Boss) === d.bossId);\n// La contribution qui vient d'etre creee dans ce meme appel n'est pas\n// encore dans 'Get Boss Contributions' (recuperee avant la mutation) : on\n// l'ajoute manuellement pour que l'attaquant du coup fatal soit lui aussi\n// recompense.\nconst contributorIds = new Set(contributions.map((c) => refId(c.User)));\ncontributorIds.add(d.userId);\nconst users = $('Get Users').all().map((i) => i.json).filter((r) => r.id != null);\nreturn [...contributorIds].map((uid) => {\n  const user = users.find((u) => u.id === uid);\n  return { json: { docId: d.docId, userId: uid, newBoosterCount: (user ? (user.BoosterCount || 0) : 0) + (d.rewardBoosters || 0) } };\n});"
      }
