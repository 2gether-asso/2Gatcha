    {
      "id": "dispatch",
      "name": "Dispatch Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nconst cfg = $('Set Config').first().json;\nconst bosses = $('Get Community Boss').all().map((i) => i.json).filter((r) => r.id != null);\nconst contributions = $('Get Boss Contributions').all().map((i) => i.json).filter((r) => r.id != null);\nconst pulls = $('Get Pulls').all().map((i) => i.json).filter((r) => r.id != null);\nconst cards = $('Get Cards').all().map((i) => i.json).filter((r) => r.id != null);\nconst rarities = $('Get Rarities').all().map((i) => i.json).filter((r) => r.id != null);\nconst users = $('Get Users').all().map((i) => i.json).filter((r) => r.id != null);\nconst activeBoss = bosses.find((b) => !!b.Active);\n\nfunction bossPublicState(boss) {\n  if (!boss) return { active: false };\n  return { active: true, bossId: boss.id, bossName: boss.BossName, maxHp: boss.MaxHp, currentHp: boss.CurrentHp, rewardBoosters: boss.RewardBoosters };\n}\n\nif (cfg.action === 'attack') {\n  if (!activeBoss) return [{ json: { ...cfg, ok: false, error: 'no_active_boss' } }];\n  const card = cards.find((c) => c.id === cfg.cardId);\n  if (!card) return [{ json: { ...cfg, ok: false, error: 'card_not_found' } }];\n  if (card.IsPromo) return [{ json: { ...cfg, ok: false, error: 'promo_not_donatable' } }];\n  const pull = pulls.find((p) => refId(p.User) === cfg.userId && refId(p.Card) === cfg.cardId);\n  if (!pull) return [{ json: { ...cfg, ok: false, error: 'card_not_owned' } }];\n  const rarity = rarities.find((r) => r.id === refId(card.Rarity));\n  const damage = (rarity ? rarity.DisenchantValue : 0) || 1;\n  const newCurrentHp = Math.max(0, (activeBoss.CurrentHp || 0) - damage);\n  const defeated = newCurrentHp <= 0;\n  return [{ json: {\n    ...cfg, ok: true, mutation: 'attack',\n    bossId: activeBoss.id, bossName: activeBoss.BossName, rewardBoosters: activeBoss.RewardBoosters || 0,\n    pullRowIdToDelete: pull.id, damage, newCurrentHp, defeated\n  } }];\n}\n\nif (cfg.action === 'adminCreate') {\n  if (!cfg.isAdmin) return [{ json: { ...cfg, ok: false, error: 'forbidden' } }];\n  if (!cfg.bossName || !cfg.maxHp) return [{ json: { ...cfg, ok: false, error: 'missing_fields' } }];\n  const previousActiveIds = bosses.filter((b) => !!b.Active).map((b) => b.id);\n  return [{ json: { ...cfg, ok: true, mutation: 'adminCreate', previousActiveIds } }];\n}\n\n// action === 'status' (ou toute autre valeur) : etat courant, sans mutation.\nconst myContribution = activeBoss\n  ? contributions.filter((c) => refId(c.User) === cfg.userId && refId(c.Boss) === activeBoss.id).reduce((s, c) => s + (c.Damage || 0), 0)\n  : 0;\nreturn [{ json: { ...cfg, ok: true, mutation: 'none', ...bossPublicState(activeBoss), myContribution } }];"
      }
    },
