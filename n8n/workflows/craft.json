    {
      "id": "validate",
      "name": "Validate & Prepare",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -260,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nfunction firstAttachment(v) {\n  if (!Array.isArray(v) || !v.length) return null;\n  const ids = v[0] === 'L' ? v.slice(1) : v;\n  return ids.length ? ids[0] : null;\n}\n\nconst config = $('Set Config').first().json;\nconst cardsRows = $('Get Cards').all().map((i) => i.json).filter((r) => r.id != null);\nconst raritiesRows = $('Get Rarities').all().map((i) => i.json).filter((r) => r.id != null);\nconst usersRows = $('Get Users').all().map((i) => i.json).filter((r) => r.id != null);\nconst allPulls = $('Get All Pulls').all().map((i) => i.json).filter((r) => r.id != null);\n\nconst card = cardsRows.find((c) => c.id === config.cardId);\nif (!card) return [{ json: { ok: false, error: 'card_not_found' } }];\nif (card.IsPromo) return [{ json: { ok: false, error: 'promo_not_craftable' } }];\nif (card.Active === false) return [{ json: { ok: false, error: 'card_inactive' } }];\n\n// Limite d'exemplaires 'dans la nature' (Cards.MaxSerial, 100 par defaut) :\n// une fois atteinte, la carte n'est plus obtenable par aucun moyen.\nconst existingCount = allPulls.filter((p) => refId(p.Card) === card.id).length;\nconst maxSerial = card.MaxSerial || 100;\nif (existingCount >= maxSerial) return [{ json: { ok: false, error: 'sold_out' } }];\n\nconst user = usersRows.find((u) => u.id === config.userId);\nif (!user) return [{ json: { ok: false, error: 'unknown_user' } }];\n\nconst rarityRow = raritiesRows.find((r) => r.id === refId(card.Rarity));\nconst craftCost = rarityRow ? (rarityRow.CraftCost || 0) : 0;\nconst stardust = user.StardustCount || 0;\nif (stardust < craftCost) return [{ json: { ok: false, error: 'insufficient_dust' } }];\n\nconst now = Math.floor(Date.now() / 1000);\nconst rarity = rarityRow ? { id: rarityRow.id, name: rarityRow.Name, key: rarityRow.Key, colorHex: rarityRow.ColorHex } : null;\n\n// Niveaux de profil : XP gagnee en craftant, +1 booster bonus par niveau\n// franchi.\nfunction levelForXp(xp) { xp = xp || 0; return Math.floor((25 + Math.sqrt(625 + 100 * xp)) / 50); }\nconst XP_PER_CRAFT = 5;\nconst oldXp = user.XP || 0;\nconst newXp = oldXp + XP_PER_CRAFT;\nconst levelsGained = levelForXp(newXp) - levelForXp(oldXp);\n\nreturn [{\n  json: {\n    ok: true,\n    docId: config.docId,\n    userId: config.userId,\n    cardId: card.id,\n    name: card.Name,\n    artist: card.Artist,\n    description: card.Description,\n    imageId: firstAttachment(card.Image),\n    rarity,\n    obtainedAt: now,\n    batchId: `craft-${config.userId}-${Date.now()}`,\n    craftCost,\n    newStardust: stardust - craftCost,\n    serialNumber: existingCount + 1,\n    maxSerial,\n    newXp,\n    newBoosterCount: (user.BoosterCount || 0) + levelsGained\n  }\n}];"
      }
    },
