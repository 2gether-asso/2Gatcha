        "responseBody": "={{ { crafted: true, card: { cardId: $('Validate & Prepare').first().json.cardId, name: $('Validate & Prepare').first().json.name, artist: $('Validate & Prepare').first().json.artist, description: $('Validate & Prepare').first().json.description, imageId: $('Validate & Prepare').first().json.imageId, rarity: $('Validate & Prepare').first().json.rarity }, craftCost: $('Validate & Prepare').first().json.craftCost, newStardust: $('Validate & Prepare').first().json.newStardust } }}",
        "options": {}
      },
      "id": "respond-ok", "name": "Respond OK", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.1, "position": [620, 180]
    }
