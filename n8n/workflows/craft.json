{
  "name": "2Gatcha - craft",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "craft", "responseMode": "responseNode", "options": {} },
      "id": "webhook", "name": "Webhook", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [-1400, 300]
    },
    {
      "parameters": {
