          { "fieldId": "Card", "fieldValue": "={{ $json.cardId }}" },
          { "fieldId": "ObtainedAt", "fieldValue": "={{ $json.obtainedAt }}" },
          { "fieldId": "BatchId", "fieldValue": "={{ $json.batchId }}" }
        ] }
      },
      "id": "create-pull", "name": "Create Pull", "type": "n8n-nodes-base.grist", "typeVersion": 1, "position": [180, 180],
      "credentials": { "gristApi": { "id": "Yoc8FS9lCXpWBRrk", "name": "Grist account" } }
    },
    {
      "parameters": {
        "operation": "update",
        "docId": "={{ $('Validate & Prepare').first().json.docId }}",
        "tableId": "Users",
        "rowId": "={{ $('Validate & Prepare').first().json.userId }}",
        "dataToSend": "defineInNode",
        "fieldsToSend": { "properties": [ { "fieldId": "StardustCount", "fieldValue": "={{ $('Validate & Prepare').first().json.newStardust }}" } ] }
      },
      "id": "update-user", "name": "Update User", "type": "n8n-nodes-base.grist", "typeVersion": 1, "position": [400, 180],
      "credentials": { "gristApi": { "id": "Yoc8FS9lCXpWBRrk", "name": "Grist account" } }
    },
    {
