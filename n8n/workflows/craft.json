        "jsCode": "const body = $input.first().json.body || {};\nreturn [{\n  json: {\n    docId: 'cRP1WgZQv7KmwmVrUbuEF8',\n    userId: Number(body.userId),\n    cardId: Number(body.cardId)\n  }\n}];"
      },
      "id": "set-config", "name": "Set Config", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [-1180, 300]
    },
    {
      "parameters": { "operation": "getAll", "docId": "={{ $json.docId }}", "tableId": "Cards", "returnAll": true, "additionalOptions": {} },
      "id": "get-cards", "name": "Get Cards", "type": "n8n-nodes-base.grist", "typeVersion": 1, "position": [-960, 300],
      "alwaysOutputData": true, "credentials": { "gristApi": { "id": "Yoc8FS9lCXpWBRrk", "name": "Grist account" } }
    },
    { "parameters": { "mode": "runOnceForAllItems", "jsCode": "return [{ json: {} }];" }, "id": "barrier-1", "name": "Sync Get Cards -> Get Rarities", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [-820, 300] },
    {
      "parameters": { "operation": "getAll", "docId": "={{ $('Set Config').first().json.docId }}", "tableId": "Rarities", "returnAll": true, "additionalOptions": {} },
      "id": "get-rarities", "name": "Get Rarities", "type": "n8n-nodes-base.grist", "typeVersion": 1, "position": [-680, 300],
      "alwaysOutputData": true, "credentials": { "gristApi": { "id": "Yoc8FS9lCXpWBRrk", "name": "Grist account" } }
    },
    { "parameters": { "mode": "runOnceForAllItems", "jsCode": "return [{ json: {} }];" }, "id": "barrier-2", "name": "Sync Get Rarities -> Get Users", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [-540, 300] },
    {
      "parameters": { "operation": "getAll", "docId": "={{ $('Set Config').first().json.docId }}", "tableId": "Users", "returnAll": true, "additionalOptions": {} },
      "id": "get-users", "name": "Get Users", "type": "n8n-nodes-base.grist", "typeVersion": 1, "position": [-400, 300],
      "alwaysOutputData": true, "credentials": { "gristApi": { "id": "Yoc8FS9lCXpWBRrk", "name": "Grist account" } }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nfunction firstAttachment(v) {\n  if (!Array.isArray(v) || !v.length) return null;\n  const ids = v[0] === 'L' ? v.slice(1) : v;\n  return ids.length ? ids[0] : null;\n}\n\nconst config = $('Set Config').first().json;\nconst cardsRows = $('Get Cards').all().map((i) => i.json).filter((r) => r.id != null);\nconst raritiesRows = $('Get Rarities').all().map((i) => i.json).filter((r) => r.id != null);\nconst usersRows = $('Get Users').all().map((i) => i.json).filter((r) => r.id != null);\n\nconst card = cardsRows.find((c) => c.id === config.cardId);\nif (!card) return [{ json: { ok: false, error: 'card_not_found' } }];\nif (card.IsPromo) return [{ json: { ok: false, error: 'promo_not_craftable' } }];\nif (card.Active === false) return [{ json: { ok: false, error: 'card_inactive' } }];\n\nconst user = usersRows.find((u) => u.id === config.userId);\nif (!user) return [{ json: { ok: false, error: 'unknown_user' } }];\n\nconst rarityRow = raritiesRows.find((r) => r.id === refId(card.Rarity));\nconst craftCost = rarityRow ? (rarityRow.CraftCost || 0) : 0;\nconst stardust = user.StardustCount || 0;\nif (stardust < craftCost) return [{ json: { ok: false, error: 'insufficient_dust' } }];\n\nconst now = Math.floor(Date.now() / 1000);\nconst rarity = rarityRow ? { id: rarityRow.id, name: rarityRow.Name, key: rarityRow.Key, colorHex: rarityRow.ColorHex } : null;\n\nreturn [{\n  json: {\n    ok: true,\n    docId: config.docId,\n    userId: config.userId,\n    cardId: card.id,\n    name: card.Name,\n    artist: card.Artist,\n    description: card.Description,\n    imageId: firstAttachment(card.Image),\n    rarity,\n    obtainedAt: now,\n    batchId: `craft-${config.userId}-${Date.now()}`,\n    craftCost,\n    newStardust: stardust - craftCost\n  }\n}];"
      },
      "id": "validate", "name": "Validate & Prepare", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [-260, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [ { "leftValue": "={{ $json.ok }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true" } } ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-valid", "name": "If Valid", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [-40, 300]
    },
