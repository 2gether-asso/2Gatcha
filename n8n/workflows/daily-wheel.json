{
  "name": "2Gatcha - daily-wheel",
  "nodes": [
    {
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1800,
        400
      ],
      "webhookId": "c1a2b3d4-daily-wheel-000-000000000000",
      "parameters": {
        "httpMethod": "POST",
        "path": "daily-wheel",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "set-config",
      "name": "Set Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1580,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body = $input.first().json.body || {};\nreturn [{ json: {\n  docId: 'cRP1WgZQv7KmwmVrUbuEF8',\n  userId: Number(body.userId),\n  action: (body.action || 'status').toString(),\n  today: new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Paris' }).format(new Date())\n} }];"
      }
    },
    {
      "id": "get-users",
      "name": "Get Users",
      "type": "n8n-nodes-base.grist",
      "typeVersion": 1,
      "position": [
        -1360,
        400
      ],
      "alwaysOutputData": true,
      "parameters": {
        "operation": "getAll",
        "docId": "={{ $('Set Config').first().json.docId }}",
        "tableId": "Users",
        "returnAll": true,
        "additionalOptions": {}
      },
      "credentials": {
        "gristApi": {
          "id": "Yoc8FS9lCXpWBRrk",
          "name": "Grist account"
        }
      }
    },
    {
      "id": "compute-result",
      "name": "Compute Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1140,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cfg = $('Set Config').first().json;\nconst users = $('Get Users').all().map((i) => i.json).filter((r) => r.id != null);\nconst user = users.find((u) => u.id === cfg.userId);\nif (!user) return [{ json: { ok: false, error: 'user_not_found' } }];\n\nfunction toDateStr(v) { if (v == null) return null; if (typeof v === \"number\") return new Date(v * 1000).toISOString().slice(0, 10); return String(v).slice(0, 10); }\nconst alreadySpun = toDateStr(user.LastWheelSpinDate) === cfg.today;\n\nif (cfg.action === 'status') {\n  return [{ json: { ok: true, docId: cfg.docId, userId: cfg.userId, canSpin: !alreadySpun, shouldUpdate: false } }];\n}\n\nif (alreadySpun) return [{ json: { ok: false, error: 'already_spun' } }];\n\n// Mix prudent : surtout de la poussiere, rarement un booster, jamais de\n// carte directe (pas de raccourci vers les raretes fortes via la roue).\nconst roll = Math.random();\nlet prize;\nif (roll < 0.70) prize = { type: 'stardust', amount: 10 + Math.floor(Math.random() * 16), tier: 'small' };\nelse if (roll < 0.90) prize = { type: 'stardust', amount: 50 + Math.floor(Math.random() * 51), tier: 'big' };\nelse prize = { type: 'booster', amount: 1, tier: 'booster' };\n\nconst newStardust = (user.StardustCount || 0) + (prize.type === 'stardust' ? prize.amount : 0);\n\n// Niveaux de profil : XP gagnee en tournant la roue, +1 booster bonus par\n// niveau franchi (en plus du lot de la roue elle-meme).\nfunction levelForXp(xp) { xp = xp || 0; return Math.floor((25 + Math.sqrt(625 + 100 * xp)) / 50); }\nconst XP_PER_WHEEL_SPIN = 5;\nconst newXp = (user.XP || 0) + XP_PER_WHEEL_SPIN;\nconst levelsGained = levelForXp(newXp) - levelForXp(user.XP || 0);\nconst newBoosterCount = (user.BoosterCount || 0) + (prize.type === 'booster' ? prize.amount : 0) + levelsGained;\n\nreturn [{ json: {\n  ok: true, docId: cfg.docId, userId: cfg.userId, today: cfg.today,\n  shouldUpdate: true, canSpin: false, prize, newStardust, newBoosterCount, newXp\n} }];"
      }
    },
    {
      "id": "if-ok",
      "name": "If Ok",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -920,
        400
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "respond-error",
      "name": "Respond Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        -700,
        560
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { error: $json.error } }}",
        "options": {
          "responseCode": 400
        }
      }
    },
    {
      "id": "if-should-update",
      "name": "If Should Update",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -700,
        320
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.shouldUpdate }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "update-user-wheel",
      "name": "Update User",
      "type": "n8n-nodes-base.grist",
      "typeVersion": 1,
      "position": [
        -480,
        260
      ],
      "parameters": {
        "operation": "update",
        "docId": "={{ $('Compute Result').first().json.docId }}",
        "tableId": "Users",
        "rowId": "={{ $('Compute Result').first().json.userId }}",
        "dataToSend": "defineInNode",
        "fieldsToSend": {
          "properties": [
            {
              "fieldId": "StardustCount",
              "fieldValue": "={{ $('Compute Result').first().json.newStardust }}"
            },
            {
              "fieldId": "BoosterCount",
              "fieldValue": "={{ $('Compute Result').first().json.newBoosterCount }}"
            },
            {
              "fieldId": "LastWheelSpinDate",
              "fieldValue": "={{ $('Compute Result').first().json.today }}"
            },
            {
              "fieldId": "XP",
              "fieldValue": "={{ $('Compute Result').first().json.newXp }}"
            }
          ]
        }
      },
      "credentials": {
        "gristApi": {
          "id": "Yoc8FS9lCXpWBRrk",
          "name": "Grist account"
        }
      }
    },
    {
      "id": "format-response",
      "name": "Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -260,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function levelForXp(xp) { xp = xp || 0; return Math.floor((25 + Math.sqrt(625 + 100 * xp)) / 50); }\nconst r = $('Compute Result').first().json;\nif (r.prize) return [{ json: { canSpin: false, prize: r.prize, newStardust: r.newStardust, newBoosterCount: r.newBoosterCount, xp: { total: r.newXp, level: levelForXp(r.newXp) } } }];\nreturn [{ json: { canSpin: r.canSpin } }];"
      }
    },
    {
      "id": "respond-success",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        -40,
        400
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      }
    }
  ],
