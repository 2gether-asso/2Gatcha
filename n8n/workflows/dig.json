    {
      "id": "dispatch",
      "name": "Dispatch Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-40, 400],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nconst cfg = $('Set Config').first().json;\nconst users = $('Get Users').all().map((i) => i.json).filter((r) => r.id != null);\nconst user = users.find((u) => u.id === cfg.userId);\nif (!user) return [{ json: { ...cfg, ok: false, error: 'unknown_user' } }];\n\nconst MAX_ENERGY = 5;\nconst REGEN_SECONDS = 30 * 60;\nconst now = Math.floor(Date.now() / 1000);\nconst storedEnergy = user.DigEnergy != null ? user.DigEnergy : MAX_ENERGY;\nconst lastAt = user.LastDigEnergyAt || now;\nlet currentEnergy = storedEnergy;\nlet secondsUntilNext = null;\nif (storedEnergy < MAX_ENERGY) {\n  const elapsed = Math.max(0, now - lastAt);\n  const gained = Math.floor(elapsed / REGEN_SECONDS);\n  currentEnergy = Math.min(MAX_ENERGY, storedEnergy + gained);\n  if (currentEnergy < MAX_ENERGY) secondsUntilNext = REGEN_SECONDS - (elapsed % REGEN_SECONDS);\n}\n\nif (cfg.action === 'dig') {\n  if (currentEnergy < 1) return [{ json: { ...cfg, ok: false, error: 'no_energy' } }];\n  const newEnergy = currentEnergy - 1;\n\n  // Table de resultats : tres majoritairement rien ou un peu de poussiere,\n  // tres rarement une carte (toujours de la rarete la plus commune - un\n  // 'doublon perdu retrouve', pas un jackpot).\n  const roll = Math.random();\n  let outcome, dustGained = 0, boosterGranted = false;\n  if (roll < 0.60) outcome = 'nothing';\n  else if (roll < 0.85) { outcome = 'dust'; dustGained = 5 + Math.floor(Math.random() * 11); }\n  else if (roll < 0.95) { outcome = 'dust'; dustGained = 20 + Math.floor(Math.random() * 21); }\n  else if (roll < 0.99) { outcome = 'booster'; boosterGranted = true; }\n  else outcome = 'card';\n\n  let cardId = null, serialNumber = null, maxSerial = null, cardName = null;\n  if (outcome === 'card') {\n    const pulls = $('Get Pulls').all().map((i) => i.json).filter((r) => r.id != null);\n    const cards = $('Get Cards').all().map((i) => i.json).filter((r) => r.id != null);\n    const rarities = $('Get Rarities').all().map((i) => i.json).filter((r) => r.id != null);\n    const countByCard = {};\n    pulls.forEach((p) => { const cid = refId(p.Card); countByCard[cid] = (countByCard[cid] || 0) + 1; });\n    const commonRarity = rarities.filter((r) => r.SortOrder != null).sort((a, b) => (a.SortOrder || 0) - (b.SortOrder || 0))[0];\n    const candidates = cards.filter((c) => c.Active !== false && !c.IsPromo && commonRarity && refId(c.Rarity) === commonRarity.id && (countByCard[c.id] || 0) < (c.MaxSerial || 100));\n    if (candidates.length) {\n      const picked = candidates[Math.floor(Math.random() * candidates.length)];\n      cardId = picked.id;\n      cardName = picked.Name;\n      maxSerial = picked.MaxSerial || 100;\n      serialNumber = (countByCard[picked.id] || 0) + 1;\n    } else {\n      // Aucune carte commune disponible (toutes epuisees) : on degrade\n      // silencieusement vers de la poussiere plutot que de faire echouer le\n      // fouille (le joueur a quand meme depense son energie).\n      outcome = 'dust';\n      dustGained = 15;\n    }\n  }\n\n  return [{ json: {\n    ...cfg, ok: true, mutation: 'dig',\n    newEnergy, outcome, dustGained, boosterGranted,\n    newStardust: (user.StardustCount || 0) + dustGained,\n    newBoosterCount: (user.BoosterCount || 0) + (boosterGranted ? 1 : 0),\n    cardId, cardName, serialNumber, maxSerial\n  } }];\n}\n\n// action === 'status' (ou toute autre valeur) : aucune mutation, lecture seule.\nreturn [{ json: { ...cfg, ok: true, mutation: 'none', energy: currentEnergy, maxEnergy: MAX_ENERGY, secondsUntilNext } }];"
      }
    },
