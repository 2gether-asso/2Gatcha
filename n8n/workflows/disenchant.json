    },
    { "parameters": { "mode": "runOnceForAllItems", "jsCode": "return [{ json: {} }];" }, "id": "barrier-2", "name": "Sync Get Rarities -> Get Pulls", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [-540, 300] },
    {
      "parameters": { "operation": "getAll", "docId": "={{ $('Set Config').first().json.docId }}", "tableId": "Pulls", "returnAll": true, "additionalOptions": {} },
      "id": "get-pulls", "name": "Get Pulls", "type": "n8n-nodes-base.grist", "typeVersion": 1, "position": [-400, 300],
      "alwaysOutputData": true, "credentials": { "gristApi": { "id": "Yoc8FS9lCXpWBRrk", "name": "Grist account" } }
    },
    { "parameters": { "mode": "runOnceForAllItems", "jsCode": "return [{ json: {} }];" }, "id": "barrier-3", "name": "Sync Get Pulls -> Get Users", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [-260, 300] },
    {
      "parameters": { "operation": "getAll", "docId": "={{ $('Set Config').first().json.docId }}", "tableId": "Users", "returnAll": true, "additionalOptions": {} },
      "id": "get-users", "name": "Get Users", "type": "n8n-nodes-base.grist", "typeVersion": 1, "position": [-120, 300],
      "alwaysOutputData": true, "credentials": { "gristApi": { "id": "Yoc8FS9lCXpWBRrk", "name": "Grist account" } }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nconst config = $('Set Config').first().json;\nconst cardsRows = $('Get Cards').all().map((i) => i.json).filter((r) => r.id != null);\nconst raritiesRows = $('Get Rarities').all().map((i) => i.json).filter((r) => r.id != null);\nconst pullsRows = $('Get Pulls').all().map((i) => i.json).filter((r) => r.id != null);\nconst usersRows = $('Get Users').all().map((i) => i.json).filter((r) => r.id != null);\n\nconst card = cardsRows.find((c) => c.id === config.cardId);\nif (!card) return [{ json: { ok: false, error: 'card_not_found' } }];\nif (card.IsPromo) return [{ json: { ok: false, error: 'promo_not_disenchantable' } }];\n\nconst pull = pullsRows.find((p) => refId(p.User) === config.userId && refId(p.Card) === config.cardId);\nif (!pull) return [{ json: { ok: false, error: 'card_not_owned' } }];\n\nconst user = usersRows.find((u) => u.id === config.userId);\nif (!user) return [{ json: { ok: false, error: 'unknown_user' } }];\n\nconst rarity = raritiesRows.find((r) => r.id === refId(card.Rarity));\nconst dustGained = rarity ? (rarity.DisenchantValue || 0) : 0;\nconst newStardust = (user.StardustCount || 0) + dustGained;\n\nreturn [{\n  json: {\n    ok: true,\n    docId: config.docId,\n    userId: config.userId,\n    pullRowId: pull.id,\n    cardName: card.Name,\n    dustGained,\n    newStardust\n  }\n}];"
      },
      "id": "validate", "name": "Validate & Prepare", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [20, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [ { "leftValue": "={{ $json.ok }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true" } } ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-valid", "name": "If Valid", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [240, 300]
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={{ { error: $json.error } }}", "options": { "responseCode": 400 } },
      "id": "respond-error", "name": "Respond Error", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.1, "position": [460, 460]
    },
    {
      "parameters": {
        "operation": "delete",
        "docId": "={{ $json.docId }}",
        "tableId": "Pulls",
        "rowId": "={{ $json.pullRowId }}"
      },
      "id": "delete-pull", "name": "Delete Pull", "type": "n8n-nodes-base.grist", "typeVersion": 1, "position": [460, 180],
      "credentials": { "gristApi": { "id": "Yoc8FS9lCXpWBRrk", "name": "Grist account" } }
    },
    {
      "parameters": {
        "operation": "update",
        "docId": "={{ $('Validate & Prepare').first().json.docId }}",
        "tableId": "Users",
        "rowId": "={{ $('Validate & Prepare').first().json.userId }}",
        "dataToSend": "defineInNode",
        "fieldsToSend": { "properties": [ { "fieldId": "StardustCount", "fieldValue": "={{ $('Validate & Prepare').first().json.newStardust }}" } ] }
      },
      "id": "update-user", "name": "Update User", "type": "n8n-nodes-base.grist", "typeVersion": 1, "position": [680, 180],
      "credentials": { "gristApi": { "id": "Yoc8FS9lCXpWBRrk", "name": "Grist account" } }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { disenchanted: true, cardName: $('Validate & Prepare').first().json.cardName, dustGained: $('Validate & Prepare').first().json.dustGained, newStardust: $('Validate & Prepare').first().json.newStardust } }}",
        "options": {}
      },
      "id": "respond-ok", "name": "Respond OK", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.1, "position": [900, 180]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Set Config", "type": "main", "index": 0 }]] },
    "Set Config": { "main": [[{ "node": "Get Cards", "type": "main", "index": 0 }]] },
