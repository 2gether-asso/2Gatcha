    {
      "id": "compute-upgrade",
      "name": "Compute Upgrade",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -680,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nconst cfg = $('Set Config').first().json;\nconst allPulls = $('Get Pulls').all().map((i) => i.json).filter((r) => r.id != null);\nconst cards = $('Get Cards').all().map((i) => i.json).filter((r) => r.id != null);\nconst card = cards.find((c) => c.id === cfg.cardId);\n\nif (!card) return [{ json: { ok: false, error: 'card_not_found' } }];\nif (card.IsPromo) return [{ json: { ok: false, error: 'promo_not_upgradable' } }];\nif (card.Active === false) return [{ json: { ok: false, error: 'card_inactive' } }];\n\n// Echelle de finitions fixe, du plus commun au plus prestigieux. Chaque\n// palier consomme 5 exemplaires IDENTIQUES (meme carte, meme finition) pour\n// en produire 1 seul de la finition suivante - deterministe, pas de RNG\n// (contrairement a l'autel de sacrifice).\nconst FINISH_ORDER = ['normal', 'holo', 'gold', 'ghost', 'diamond', 'rainbow'];\nconst fromIndex = FINISH_ORDER.indexOf(cfg.fromFinish);\nif (fromIndex === -1 || fromIndex === FINISH_ORDER.length - 1) {\n  return [{ json: { ok: false, error: 'invalid_finish' } }];\n}\nconst toFinish = FINISH_ORDER[fromIndex + 1];\n\nfunction finishOf(p) { return p.Finish || 'normal'; }\nconst myPulls = allPulls.filter((p) => refId(p.User) === cfg.userId);\nconst matching = myPulls.filter((p) => refId(p.Card) === cfg.cardId && finishOf(p) === cfg.fromFinish);\nif (matching.length < 5) {\n  return [{ json: { ok: false, error: 'not_enough_duplicates' } }];\n}\n\n// Limite d'exemplaires 'dans la nature' (Cards.MaxSerial, 100 par defaut) :\n// la carte fusionnee est un nouvel exemplaire, elle compte dans le meme\n// compteur global que les tirages/craft normaux, tous finitions confondues.\nconst existingCount = allPulls.filter((p) => refId(p.Card) === cfg.cardId).length;\nconst maxSerial = card.MaxSerial || 100;\nif (existingCount >= maxSerial) {\n  return [{ json: { ok: false, error: 'sold_out' } }];\n}\n\nconst pullIdsToDelete = matching.slice(0, 5).map((p) => p.id);\n\nreturn [{ json: {\n  ok: true,\n  docId: cfg.docId,\n  userId: cfg.userId,\n  cardId: cfg.cardId,\n  pullIdsToDelete,\n  fromFinish: cfg.fromFinish,\n  toFinish,\n  obtainedAt: Math.floor(Date.now() / 1000),\n  batchId: `foil-${cfg.userId}-${Date.now()}`,\n  serialNumber: existingCount + 1,\n  maxSerial\n} }];"
      }
    },
