    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nconst config = $('Set Config').first().json;\nconst userRows = $('Get Users').all().map((i) => i.json).filter((r) => r.id != null);\nconst user = userRows.find((u) => u.id === config.userId);\nif (!user) {\n  throw new Error('Utilisateur introuvable (userId=' + config.userId + ')');\n}\n\nconst extensionsRows = $('Get Extensions').all().map((i) => i.json).filter((r) => r.id != null && r.Active !== false);\nconst invRows = $('Get Booster Inventory').all().map((i) => i.json).filter((r) => r.id != null && refId(r.User) === config.userId);\nconst invByExtension = {};\ninvRows.forEach((r) => { invByExtension[refId(r.Extension)] = r; });\n\n// Le solde de boosters est generique (Users.BoosterCount, commun a toutes\n// les extensions) : seule la progression vers la pity reste par extension.\nconst extensions = extensionsRows\n  .map((e) => ({\n    extensionId: e.id,\n    name: e.Name,\n    key: e.Key,\n    sortOrder: e.SortOrder || 0,\n    pullsSinceTop: (invByExtension[e.id] && invByExtension[e.id].PullsSinceTopRarity) || 0\n  }))\n  .sort((a, b) => a.sortOrder - b.sortOrder);\n\nreturn [{ json: { count: user.BoosterCount || 0, stardust: user.StardustCount || 0, extensions } }];"
      },
