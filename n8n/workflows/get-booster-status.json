    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// A adapter une seule fois : ID du document Grist.\nconst userId = Number($input.first().json.query.userId);\nreturn [{ json: { docId: 'cRP1WgZQv7KmwmVrUbuEF8', userId } }];"
      },
      "id": "set-config",
      "name": "Set Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-180, 300]
    },
    {
      "parameters": {
        "operation": "getAll",
        "docId": "={{ $json.docId }}",
        "tableId": "Users",
        "returnAll": true,
        "additionalOptions": {}
      },
      "id": "get-users",
      "name": "Get Users",
      "type": "n8n-nodes-base.grist",
      "typeVersion": 1,
      "position": [40, 300],
      "alwaysOutputData": true,
      "credentials": { "gristApi": { "id": "Yoc8FS9lCXpWBRrk", "name": "Grist account" } }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Plus d'accroissement horaire ni de plafond : BoosterCount est un simple\n// solde, modifie uniquement par redeem-code.json (+N) et open-pack.json (-1).\nconst config = $('Set Config').first().json;\nconst userRows = $('Get Users').all().map((i) => i.json);\nconst user = userRows.find((u) => u.id === config.userId);\nif (!user) {\n  throw new Error('Utilisateur introuvable (userId=' + config.userId + ')');\n}\n\nreturn [{ json: { count: user.BoosterCount || 0 } }];"
      },
      "id": "format-response",
      "name": "Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [260, 300]
    },
