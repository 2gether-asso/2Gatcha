    {
      "id": "format-response",
      "name": "Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -60,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nconst config = $('Set Config').first().json;\nconst userRows = $('Get Users').all().map((i) => i.json).filter((r) => r.id != null);\nconst user = userRows.find((u) => u.id === config.userId);\nif (!user) {\n  throw new Error('Utilisateur introuvable (userId=' + config.userId + ')');\n}\n\nconst extensionsRows = $('Get Extensions').all().map((i) => i.json).filter((r) => r.id != null && r.Active !== false);\nconst invRows = $('Get Booster Inventory').all().map((i) => i.json).filter((r) => r.id != null && refId(r.User) === config.userId);\nconst invByExtension = {};\ninvRows.forEach((r) => { invByExtension[refId(r.Extension)] = r; });\n\n// Le solde de boosters est generique (Users.BoosterCount, commun a toutes\n// les extensions) : seule la progression vers la pity reste par extension.\nconst extensions = extensionsRows\n  .map((e) => ({\n    extensionId: e.id,\n    name: e.Name,\n    key: e.Key,\n    sortOrder: e.SortOrder || 0,\n    pullsSinceTop: (invByExtension[e.id] && invByExtension[e.id].PullsSinceTopRarity) || 0\n  }))\n  .sort((a, b) => a.sortOrder - b.sortOrder);\n\nconst configRows = $('Get Config').all().map((i) => i.json).filter((r) => r.id != null);\nconst pityThreshold = configRows.length ? (configRows[0].PityThreshold || 0) : 0;\n\n// Niveaux de profil : jamais stocke, toujours recalcule depuis Users.XP.\n// Palier croissant (voir grist/SCHEMA.md) : passer du niveau n au niveau\n// n+1 coute 50*n XP (50 pour le niveau 1, 100 pour le niveau 2, etc.), donc\n// le cumul pour ETRE au niveau L vaut 25*L*(L-1) - la formule ci-dessous en\n// est l'inverse (racine positive de 25*L^2 - 25*L - xp = 0).\nconst xp = user.XP || 0;\nfunction levelForXp(x) { return Math.floor((25 + Math.sqrt(625 + 100 * x)) / 50); }\nconst level = levelForXp(xp);\nconst xpIntoLevel = xp - 25 * level * (level - 1);\nconst xpForNextLevel = 50 * level;\n\nreturn [{ json: { count: user.BoosterCount || 0, stardust: user.StardustCount || 0, pityThreshold, extensions, xp: { total: xp, level, xpIntoLevel, xpForNextLevel } } }];"
      }
    },
