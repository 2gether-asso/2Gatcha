    {
      "parameters": {
        "operation": "getAll",
        "docId": "={{ $('Set Config').first().json.docId }}",
        "tableId": "Rarities",
        "returnAll": true,
        "additionalOptions": {}
      },
      "id": "get-rarities",
      "name": "Get Rarities",
      "type": "n8n-nodes-base.grist",
      "typeVersion": 1,
      "position": [440, 300],
      "alwaysOutputData": true,
      "credentials": { "gristApi": { "id": "Yoc8FS9lCXpWBRrk", "name": "Grist account" } }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Grist encode les colonnes de type liste (Attachments, RefList) sous la\n// forme [\"L\", id1, id2, ...] : \"L\" est un marqueur, pas une valeur.\nfunction refId(v) { return Array.isArray(v) ? v[1] : v; }\nfunction firstAttachment(v) {\n  if (!Array.isArray(v) || !v.length) return null;\n  const ids = v[0] === 'L' ? v.slice(1) : v;\n  return ids.length ? ids[0] : null;\n}\n\nconst cardsRows = $('Get Cards').all().map((i) => i.json).filter((c) => c.Active);\nconst raritiesRows = $('Get Rarities').all().map((i) => i.json);\n\nconst rarityById = {};\nraritiesRows.forEach((r) => {\n  rarityById[r.id] = { id: r.id, name: r.Name, key: r.Key, colorHex: r.ColorHex };\n});\n\nconst cards = cardsRows.map((c) => {\n  return {\n    cardId: c.id,\n    name: c.Name,\n    artist: c.Artist,\n    description: c.Description,\n    imageId: firstAttachment(c.Image),\n    rarity: rarityById[refId(c.Rarity)] || null\n  };\n});\n\nreturn [{ json: { cards } }];"
      },
      "id": "format-cards",
      "name": "Format Cards",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [880, 300]
    }
  ],
  "connections": {
