    "Set Config": { "main": [[{ "node": "Get Cards", "type": "main", "index": 0 }]] },
    "Get Cards": { "main": [[{ "node": "Get Rarities", "type": "main", "index": 0 }]] },
    "Get Rarities": { "main": [[{ "node": "Format Cards", "type": "main", "index": 0 }]] },
    "Format Cards": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] }
  },
