    {
      "id": "format-response",
      "name": "Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        180
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nfunction firstAttachment(v) {\n  if (!Array.isArray(v) || !v.length) return null;\n  const ids = v[0] === 'L' ? v.slice(1) : v;\n  return ids.length ? ids[0] : null;\n}\nconst cfg = $('Set Config').first().json;\nconst users = $('Get Users').all().map((i) => i.json).filter((r) => r.id != null);\nconst user = users.find((u) => (u.Pseudo || '').toString().trim().toLowerCase() === cfg.pseudo.toLowerCase());\nconst pulls = $('Get Pulls').all().map((i) => i.json).filter((r) => r.id != null && refId(r.User) === user.id);\nconst cards = $('Get Cards').all().map((i) => i.json).filter((r) => r.id != null);\nconst rarities = $('Get Rarities').all().map((i) => i.json).filter((r) => r.id != null);\nconst rarityById = {}; rarities.forEach((r) => { rarityById[r.id] = r; });\nconst cardById = {}; cards.forEach((c) => { cardById[c.id] = c; });\n\nconst countByCard = {};\npulls.forEach((p) => { const cid = refId(p.Card); countByCard[cid] = (countByCard[cid] || 0) + 1; });\n\nconst owned = Object.entries(countByCard).map(([cid, count]) => {\n  const card = cardById[Number(cid)];\n  if (!card) return null;\n  const rarity = rarityById[refId(card.Rarity)];\n  return {\n    cardId: card.id,\n    name: card.Name,\n    artist: card.Artist,\n    imageId: firstAttachment(card.Image),\n    isPromo: card.IsPromo === true,\n    count,\n    rarity: rarity ? { key: rarity.Key, name: rarity.Name, colorHex: rarity.ColorHex, sortOrder: rarity.SortOrder || 0 } : null\n  };\n}).filter(Boolean).sort((a, b) => (a.rarity?.sortOrder || 0) - (b.rarity?.sortOrder || 0));\n\nreturn [{ json: {\n  pseudo: user.Pseudo,\n  discordAvatar: user.DiscordAvatar || null,\n  totalPulls: user.TotalPulls || 0,\n  uniqueCards: owned.length,\n  totalCards: cards.length,\n  isComplete: cards.length > 0 && owned.length === cards.length,\n  memberSince: user.CreatedAt || null,\n  cards: owned\n} }];"
      }
    },
