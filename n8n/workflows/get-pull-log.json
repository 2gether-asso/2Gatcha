      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nfunction firstAttachment(v) {\n  if (!Array.isArray(v) || !v.length) return null;\n  const ids = v[0] === 'L' ? v.slice(1) : v;\n  return ids.length ? ids[0] : null;\n}\nconst cfg = $('Set Config').first().json;\nconst pulls = $('Get Pulls').all().map((i) => i.json).filter((r) => r.id != null && refId(r.User) === cfg.userId);\nconst cards = $('Get Cards').all().map((i) => i.json).filter((r) => r.id != null);\nconst rarities = $('Get Rarities').all().map((i) => i.json).filter((r) => r.id != null);\nconst extensions = $('Get Extensions').all().map((i) => i.json).filter((r) => r.id != null);\nconst cardById = {}; cards.forEach((c) => { cardById[c.id] = c; });\nconst rarityById = {}; rarities.forEach((r) => { rarityById[r.id] = r; });\nconst extById = {}; extensions.forEach((e) => { extById[e.id] = e; });\n\n// La source du tirage se lit dans le prefixe de BatchId (meme convention\n// que le reste du projet : 'craft-', 'altar-', 'code-<code>-...', et le\n// format par defaut '<userId>-<timestamp>' pour un booster classique).\nfunction sourceOf(batchId) {\n  const id = (batchId || '').toString();\n  if (id.startsWith('craft-')) return 'craft';\n  if (id.startsWith('altar-')) return 'altar';\n  if (id.startsWith('code-')) return 'code';\n  return 'booster';\n}\n\nconst log = pulls\n  .sort((a, b) => (b.ObtainedAt || 0) - (a.ObtainedAt || 0))\n  .map((p) => {\n    const card = cardById[refId(p.Card)];\n    const rarity = card ? rarityById[refId(card.Rarity)] : null;\n    const ext = card ? extById[refId(card.Extension)] : null;\n    return {\n      cardId: card ? card.id : null,\n      cardName: (card && card.Name) || '?',\n      imageId: card ? firstAttachment(card.Image) : null,\n      rarity: rarity ? { key: rarity.Key, name: rarity.Name, colorHex: rarity.ColorHex } : null,\n      extension: ext ? { key: ext.Key, name: ext.Name } : null,\n      source: sourceOf(p.BatchId),\n      obtainedAt: p.ObtainedAt || 0\n    };\n  });\n\nconst rarityWeights = rarities.map((r) => ({ key: r.Key, name: r.Name, colorHex: r.ColorHex, weight: r.Weight || 0 }));\n\nreturn [{ json: { log, total: log.length, rarityWeights } }];"
      }
