    {
      "id": "dispatch",
      "name": "Dispatch Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -80,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nconst cfg = $('Set Config').first().json;\nconst deposits = $('Get Guild Chest Deposits').all().map((i) => i.json).filter((r) => r.id != null);\nconst claims = $('Get Guild Chest Claims').all().map((i) => i.json).filter((r) => r.id != null);\nconst pulls = $('Get Pulls').all().map((i) => i.json).filter((r) => r.id != null);\nconst cards = $('Get Cards').all().map((i) => i.json).filter((r) => r.id != null);\n\nconst alreadyDrawnToday = claims.some((c) => refId(c.User) === cfg.userId && c.Date === cfg.today);\n\nif (cfg.action === 'deposit') {\n  const card = cards.find((c) => c.id === cfg.cardId);\n  if (!card) return [{ json: { ...cfg, ok: false, error: 'card_not_found' } }];\n  if (card.IsPromo) return [{ json: { ...cfg, ok: false, error: 'promo_not_donatable' } }];\n  const pull = pulls.find((p) => refId(p.User) === cfg.userId && refId(p.Card) === cfg.cardId);\n  if (!pull) return [{ json: { ...cfg, ok: false, error: 'card_not_owned' } }];\n  return [{ json: { ...cfg, ok: true, mutation: 'deposit', pullRowIdToDelete: pull.id, serialNumber: pull.SerialNumber } }];\n}\n\nif (cfg.action === 'draw') {\n  if (alreadyDrawnToday) return [{ json: { ...cfg, ok: false, error: 'already_drawn_today' } }];\n  const candidates = deposits.filter((d) => !d.Claimed && refId(d.User) !== cfg.userId);\n  if (!candidates.length) return [{ json: { ...cfg, ok: false, error: 'chest_empty' } }];\n  const picked = candidates[Math.floor(Math.random() * candidates.length)];\n  return [{ json: { ...cfg, ok: true, mutation: 'draw', depositRowId: picked.id, drawnCardId: refId(picked.CardId), drawnSerialNumber: picked.SerialNumber } }];\n}\n\n// action === 'status' (ou toute autre valeur) : aucune mutation.\nconst poolSize = deposits.filter((d) => !d.Claimed && refId(d.User) !== cfg.userId).length;\nreturn [{ json: { ...cfg, ok: true, mutation: 'none', poolSize, alreadyDrawnToday } }];"
      }
