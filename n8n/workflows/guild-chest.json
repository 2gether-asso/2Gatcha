        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nfunction firstAttachment(v) { if (!Array.isArray(v) || !v.length) return null; const ids = v[0] === 'L' ? v.slice(1) : v; return ids.length ? ids[0] : null; }\nconst d = $('Dispatch Action').first().json;\nconst cards = $('Get Cards').all().map((i) => i.json).filter((c) => c.id != null);\nconst rarities = $('Get Rarities').all().map((i) => i.json).filter((r) => r.id != null);\nconst card = cards.find((c) => c.id === d.drawnCardId);\nconst rarity = card ? rarities.find((r) => r.id === refId(card.Rarity)) : null;\nreturn [{ json: {\n  drawn: true,\n  card: card ? {\n    cardId: card.id, name: card.Name, artist: card.Artist, imageId: firstAttachment(card.Image),\n    rarity: rarity ? { key: rarity.Key, name: rarity.Name, colorHex: rarity.ColorHex } : null,\n    serialNumber: d.drawnSerialNumber,\n    finish: d.drawnFinish,\n    quality: d.drawnQuality\n  } : null\n} }];"
