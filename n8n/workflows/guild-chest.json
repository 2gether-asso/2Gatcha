        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nconst myClaim = $('Create Guild Chest Claim').first().json;\nconst myPull = $('Create Drawn Pull').first().json;\nconst d = $('Dispatch Action').first().json;\nconst rivals = $('Recheck Guild Chest Claims').all().map((i) => i.json).filter((r) => r.id != null && refId(r.DepositRowId) === d.depositRowId);\nrivals.sort((a, b) => a.id - b.id);\n// Le premier (id le plus bas = ecrit le premier) gagne le depot - meme\n// classement obtenu par tous les tireurs concurrents une fois leurs\n// ecritures visibles.\nconst winner = rivals[0];\nconst iWon = !winner || winner.id === myClaim.id;\nif (iWon) return [{ json: { rollback: false } }];\nreturn [{ json: { rollback: true, docId: d.docId, myClaimRowId: myClaim.id, myPullRowId: myPull.id } }];"
      }
