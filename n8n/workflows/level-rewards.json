      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function firstAttachment(v) { if (!Array.isArray(v) || !v.length) return null; const ids = v[0] === 'L' ? v.slice(1) : v; return ids.length ? ids[0] : null; }\nconst d = $('Dispatch Action').first().json;\nconst cards = $('Get Cards').all().map((i) => i.json).filter((r) => r.id != null);\nconst cardById = {}; cards.forEach((c) => { cardById[c.id] = c; });\nconst createdCards = (d.cardLevels || []).map((cl) => {\n  const card = cardById[cl.cardId];\n  return card ? { level: cl.level, cardId: card.id, name: card.Name, artist: card.Artist, imageId: firstAttachment(card.Image) } : null;\n}).filter(Boolean);\nreturn [{ json: {\n  claimed: true,\n  fromLevel: d.fromLevel, toLevel: d.toLevel,\n  dustGained: d.totalDust, boostersGained: d.totalBoosters,\n  cards: createdCards,\n  newStardust: d.newStardust, newBoosterCount: d.newBoosterCount\n} }];"
