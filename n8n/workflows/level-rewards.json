      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nconst d = $('Dispatch Action').first().json;\nif (!d.cardLevels || !d.cardLevels.length) return [];\nconst pulls = $('Get Pulls').all().map((i) => i.json).filter((r) => r.id != null);\nconst usedSerials = {};\npulls.forEach((p) => { const cid = refId(p.Card); if (!usedSerials[cid]) usedSerials[cid] = new Set(); if (p.SerialNumber != null) usedSerials[cid].add(p.SerialNumber); });\nfunction nextSerialFor(cid) { if (!usedSerials[cid]) usedSerials[cid] = new Set(); const used = usedSerials[cid]; for (let n = 1; ; n++) { if (!used.has(n)) { used.add(n); return n; } } }\nreturn d.cardLevels.map((cl) => ({ json: {\n  docId: d.docId, userId: d.userId, cardId: cl.cardId, level: cl.level,\n  obtainedAt: Math.floor(Date.now() / 1000),\n  batchId: `levelup-${d.userId}-${cl.level}-${Date.now()}`,\n  serialNumber: nextSerialFor(cl.cardId)\n} }));"
      }
    },
