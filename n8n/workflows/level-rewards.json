    {
      "id": "dispatch-action",
      "name": "Dispatch Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -460,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nconst cfg = $('Set Config').first().json;\nconst users = $('Get Users').all().map((i) => i.json).filter((r) => r.id != null);\nconst user = users.find((u) => u.id === cfg.userId);\n\n// Meme formule que partout ailleurs (voir grist/SCHEMA.md) : passer du\n// niveau n au niveau n+1 coute 50*n XP.\nfunction levelForXp(x) { return Math.floor((25 + Math.sqrt(625 + 100 * (x || 0))) / 50); }\n\nif (cfg.action === 'adminSet') {\n  if (!cfg.isAdmin) return [{ json: { ...cfg, ok: false, error: 'forbidden' } }];\n  return [{ json: { ...cfg, ok: true, mutation: 'adminSet' } }];\n}\n\nif (cfg.action === 'adminList') {\n  if (!cfg.isAdmin) return [{ json: { ...cfg, ok: false, error: 'forbidden' } }];\n  return [{ json: { ...cfg, ok: true, mutation: 'none', isAdminList: true } }];\n}\n\nif (!user) return [{ json: { ...cfg, ok: false, error: 'unknown_user' } }];\n\nconst rewards = $('Get LevelRewards').all().map((i) => i.json).filter((r) => r.id != null);\nconst currentLevel = levelForXp(user.XP || 0);\nconst lastRewarded = user.LastRewardedLevel || 0;\n// Un palier sans ligne configuree (ou une ligne vide : 0 poussiere, 0\n// booster, pas de carte) ne rapporte simplement rien - l'admin n'a pas\n// besoin de remplir les 100 paliers pour que la fonctionnalite marche.\nconst pendingRows = rewards\n  .filter((r) => (r.Level || 0) > lastRewarded && (r.Level || 0) <= currentLevel && ((r.DustReward || 0) > 0 || (r.BoosterReward || 0) > 0 || refId(r.CardReward)))\n  .sort((a, b) => (a.Level || 0) - (b.Level || 0));\n\nif (cfg.action === 'claim') {\n  if (currentLevel <= lastRewarded) return [{ json: { ...cfg, ok: false, error: 'nothing_to_claim' } }];\n  const totalDust = pendingRows.reduce((s, r) => s + (r.DustReward || 0), 0);\n  const totalBoosters = pendingRows.reduce((s, r) => s + (r.BoosterReward || 0), 0);\n  const cardLevels = pendingRows.filter((r) => refId(r.CardReward)).map((r) => ({ level: r.Level, cardId: refId(r.CardReward) }));\n  return [{ json: {\n    ...cfg, ok: true, mutation: 'claim',\n    fromLevel: lastRewarded + 1, toLevel: currentLevel,\n    newStardust: (user.StardustCount || 0) + totalDust,\n    newBoosterCount: (user.BoosterCount || 0) + totalBoosters,\n    newLastRewardedLevel: currentLevel,\n    totalDust, totalBoosters, cardLevels\n  } }];\n}\n\n// action === 'status' (ou toute autre valeur)\n\n// Prochain palier CONFIGURE a venir (strictement au-dessus du niveau\n// actuel) : jusqu'ici la page d'accueil affichait un texte fixe \"+1\n// booster\" quel que soit le niveau/la config admin (le seul +1 booster\n// garanti a chaque niveau est accorde ailleurs, voir grist/SCHEMA.md - ceci\n// concerne les bonus SUPPLEMENTAIRES configures par palier). Le nom de\n// carte est resolu ici (Get Cards tourne deja, meme si l'action est\n// 'status') pour eviter un aller-retour de plus cote client.\nconst cards = $('Get Cards').all().map((i) => i.json).filter((r) => r.id != null);\nconst upcoming = rewards\n  .filter((r) => (r.Level || 0) > currentLevel && ((r.DustReward || 0) > 0 || (r.BoosterReward || 0) > 0 || refId(r.CardReward)))\n  .sort((a, b) => (a.Level || 0) - (b.Level || 0))[0];\nlet nextReward = null;\nif (upcoming) {\n  const cardRef = refId(upcoming.CardReward);\n  const card = cardRef ? cards.find((c) => c.id === cardRef) : null;\n  nextReward = {\n    level: upcoming.Level,\n    dust: upcoming.DustReward || 0,\n    boosters: upcoming.BoosterReward || 0,\n    cardName: card ? card.Name : null\n  };\n}\n\nreturn [{ json: {\n  ...cfg, ok: true, mutation: 'none',\n  currentLevel, lastRewardedLevel: lastRewarded,\n  hasPending: pendingRows.length > 0,\n  pendingLevels: pendingRows.map((r) => r.Level),\n  nextReward\n} }];"
      }
