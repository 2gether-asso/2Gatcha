      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nconst rewards = $('Get LevelRewards').all().map((i) => i.json).filter((r) => r.id != null);\nconst cards = $('Get Cards').all().map((i) => i.json).filter((r) => r.id != null);\nconst cardById = {}; cards.forEach((c) => { cardById[c.id] = c; });\nconst byLevel = {};\nrewards.forEach((r) => { byLevel[r.Level] = r; });\nconst rows = [];\nfor (let level = 1; level <= 100; level++) {\n  const r = byLevel[level];\n  const cardId = r ? refId(r.CardReward) : null;\n  rows.push({\n    level,\n    rowId: r ? r.id : null,\n    dust: r ? (r.DustReward || 0) : 0,\n    booster: r ? (r.BoosterReward || 0) : 0,\n    cardId: cardId || null,\n    cardName: cardId && cardById[cardId] ? cardById[cardId].Name : null\n  });\n}\nreturn [{ json: { rows } }];"
