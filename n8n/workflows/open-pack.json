      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nconst config = $('Set Config').first().json;\nconst userRows = $('Get Users').all().map((i) => i.json).filter((r) => r.id != null);\nconst user = userRows.find((u) => u.id === config.userId);\nif (!user) {\n  throw new Error('Utilisateur introuvable (userId=' + config.userId + ')');\n}\n\nconst invRows = $('Get Booster Inventory').all().map((i) => i.json).filter((r) => r.id != null);\nconst inv = invRows.find((r) => refId(r.User) === config.userId && refId(r.Extension) === config.extensionId);\n\nconst boosterCount = user.BoosterCount || 0;\n\nreturn [{\n  json: {\n    userId: config.userId,\n    extensionId: config.extensionId,\n    inventoryId: inv ? inv.id : null,\n    inventoryExists: !!inv,\n    boosterCount,\n    hasStock: boosterCount >= 1,\n    pullsSinceTop: inv ? (inv.PullsSinceTopRarity || 0) : 0,\n    totalPulls: user.TotalPulls || 0\n  }\n}];"
      },
