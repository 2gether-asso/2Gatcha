        "jsCode": "const q = $('Compute Quest Update').first().json;\nreturn [{ json: {\n  quests: {\n    login: q.LoginDone,\n    craft: q.CraftDone,\n    trade: q.TradeDone,\n    openBooster: q.OpenBoosterDone\n  },\n  completedCount: q.completedCount,\n  rewardClaimed: q.RewardClaimed,\n  justClaimedReward: q.shouldGrantReward,\n  streak: { current: q.newStreak, bonusBoosters: q.streakBonus, isNewToday: q.isFirstLoginToday }\n} }];"
