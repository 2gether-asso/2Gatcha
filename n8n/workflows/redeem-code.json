      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const config = $('Set Config').first().json;\nconst final = $('Finalize Card').first().json;\nconst users = $('Get Users').all().map((i) => i.json).filter((r) => r.id != null);\nconst user = users.find((u) => u.id === final.userId);\nconst legendaryCards = (final.cards || []).filter((c) => c.rarity && c.rarity.key === 'legendaire');\nconst shouldNotify = legendaryCards.length > 0 && !!config.discordWebhookUrl && !config.discordWebhookUrl.startsWith('CHANGE-MOI');\nconst names = legendaryCards.map((c) => c.name).join(', ');\nreturn [{ json: {\n  shouldNotify,\n  webhookUrl: config.discordWebhookUrl,\n  content: `\\u{1F31F} **${(user && user.Pseudo) || 'Un joueur'}** vient d'obtenir une carte legendaire (code) : **${names}** !`\n} }];"
