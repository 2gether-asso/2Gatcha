    {
      "id": "dispatch",
      "name": "Dispatch Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -40,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nconst cfg = $('Set Config').first().json;\nconst rows = $('Get Showcase').all().map((i) => i.json).filter((r) => r.id != null);\nconst mine = rows.filter((r) => refId(r.User) === cfg.userId).sort((a, b) => (a.SortOrder || 0) - (b.SortOrder || 0));\nconst pulls = $('Get Pulls').all().map((i) => i.json).filter((r) => r.id != null);\nconst ownsCard = pulls.some((p) => refId(p.User) === cfg.userId && refId(p.Card) === cfg.cardId);\nconst existing = mine.find((r) => refId(r.Card) === cfg.cardId);\n\n// Vitrine limitee a 5 cartes (comme annonce au joueur) : au-dela, il doit\n// d'abord en retirer une. Ajouter une carte deja dans la vitrine, ou retirer\n// une carte absente, est un no-op (idempotent, meme logique que Wishlist).\nif (cfg.action === 'add') {\n  if (existing) return [{ json: { ...cfg, ok: true, mutation: 'none' } }];\n  if (!ownsCard) return [{ json: { ok: false, error: 'card_not_owned' } }];\n  if (mine.length >= 5) return [{ json: { ok: false, error: 'showcase_full' } }];\n  const nextOrder = mine.length ? Math.max(...mine.map((r) => r.SortOrder || 0)) + 1 : 0;\n  return [{ json: { ...cfg, ok: true, mutation: 'create', nextOrder } }];\n}\nif (cfg.action === 'remove') {\n  if (!existing) return [{ json: { ...cfg, ok: true, mutation: 'none' } }];\n  return [{ json: { ...cfg, ok: true, mutation: 'delete', existingRowId: existing.id } }];\n}\n// action === 'list' (ou toute valeur inconnue) : aucune mutation, on\n// retourne juste l'etat actuel.\nreturn [{ json: { ...cfg, ok: true, mutation: 'none' } }];"
      }
    },
