    {
      "id": "format-list",
      "name": "Format List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1060,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nfunction firstAttachment(v) {\n  if (!Array.isArray(v) || !v.length) return null;\n  const ids = v[0] === 'L' ? v.slice(1) : v;\n  return ids.length ? ids[0] : null;\n}\nconst cfg = $('Dispatch Action').first().json;\n// Get Showcase a ete recupere AVANT la mutation eventuelle plus haut dans le\n// flux (meme execution) : on simule la mutation en memoire ici, comme pour\n// Wishlist, pour que la reponse reflete l'etat REEL juste apres l'action.\nlet rows = $('Get Showcase').all().map((i) => i.json).filter((r) => r.id != null && refId(r.User) === cfg.userId).sort((a, b) => (a.SortOrder || 0) - (b.SortOrder || 0));\nif (cfg.mutation === 'create') {\n  rows.push({ id: -1, User: cfg.userId, Card: cfg.cardId, SortOrder: cfg.nextOrder });\n} else if (cfg.mutation === 'delete') {\n  rows = rows.filter((r) => r.id !== cfg.existingRowId);\n}\n\nconst cards = $('Get Cards').all().map((i) => i.json).filter((r) => r.id != null);\nconst rarities = $('Get Rarities').all().map((i) => i.json).filter((r) => r.id != null);\nconst cardById = {}; cards.forEach((c) => { cardById[c.id] = c; });\nconst rarityById = {}; rarities.forEach((r) => { rarityById[r.id] = r; });\n\nconst list = rows.map((r) => {\n  const card = cardById[refId(r.Card)];\n  if (!card) return null;\n  const rarity = rarityById[refId(card.Rarity)];\n  return {\n    cardId: card.id,\n    name: card.Name,\n    artist: card.Artist,\n    imageId: firstAttachment(card.Image),\n    rarity: rarity ? { key: rarity.Key, name: rarity.Name, colorHex: rarity.ColorHex } : null\n  };\n}).filter(Boolean);\n\nreturn [{ json: { showcase: list } }];"
      }
    },
