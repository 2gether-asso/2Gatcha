        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nconst t = $('Find Trade To Respond').first().json;\nconst pulls = $input.all().map((i) => i.json).filter((r) => r.id != null);\nconst pullFrom = pulls.find((p) => refId(p.User) === t.fromUserId && refId(p.Card) === t.offeredCardId);\nconst pullTo = pulls.find((p) => refId(p.User) === t.toUserId && refId(p.Card) === t.requestedCardId);\nif (!pullFrom || !pullTo) {\n  return [{ json: { ok: false, error: 'cards_no_longer_available' } }];\n}\nreturn [{\n  json: {\n    ok: true,\n    docId: t.docId,\n    tradeId: t.tradeId,\n    pullFromId: pullFrom.id,\n    pullToId: pullTo.id,\n    toUserId: t.toUserId,\n    fromUserId: t.fromUserId,\n    respondedAt: Math.floor(Date.now() / 1000)\n  }\n}];"
