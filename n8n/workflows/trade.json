      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nconst cfg = $('Set Config').first().json;\nconst users = $('Create Get Users').all().map((i) => i.json).filter((r) => r.id != null);\nconst pulls = $('Create Get Pulls').all().map((i) => i.json).filter((r) => r.id != null);\n\nconst toUser = users.find((u) => (u.Pseudo || '').toString().trim().toLowerCase() === cfg.toPseudo.toLowerCase());\nif (!toUser) {\n  return [{ json: { ok: false, error: 'user_not_found' } }];\n}\nif (toUser.id === cfg.userId) {\n  return [{ json: { ok: false, error: 'cannot_trade_self' } }];\n}\nconst owns = pulls.some((p) => refId(p.User) === cfg.userId && refId(p.Card) === cfg.offeredCardId);\nif (!owns) {\n  return [{ json: { ok: false, error: 'card_not_owned' } }];\n}\n\nreturn [{\n  json: {\n    ok: true,\n    docId: cfg.docId,\n    fromUserId: cfg.userId,\n    toUserId: toUser.id,\n    offeredCardId: cfg.offeredCardId,\n    requestedCardId: cfg.requestedCardId,\n    createdAt: Math.floor(Date.now() / 1000)\n  }\n}];"
      },
