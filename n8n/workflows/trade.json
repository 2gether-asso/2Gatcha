    {
      "id": "build-trade-list",
      "name": "Build Trade List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1100,
        620
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nconst cfg = $('Set Config').first().json;\nconst trades = $('List Get Trades').all().map((i) => i.json).filter((r) => r.id != null);\nconst users = $('List Get Users').all().map((i) => i.json).filter((r) => r.id != null);\nconst cards = $('List Get Cards').all().map((i) => i.json).filter((r) => r.id != null);\n\nconst userById = {};\nusers.forEach((u) => { userById[u.id] = u.Pseudo; });\nconst cardById = {};\ncards.forEach((c) => { cardById[c.id] = c.Name; });\n\nconst mine = trades.filter((t) => refId(t.FromUser) === cfg.userId || refId(t.ToUser) === cfg.userId);\nconst list = mine.map((t) => {\n  const requestedId = refId(t.RequestedCard);\n  return {\n    tradeId: t.id,\n    direction: refId(t.FromUser) === cfg.userId ? 'outgoing' : 'incoming',\n    fromPseudo: userById[refId(t.FromUser)] || '?',\n    toPseudo: userById[refId(t.ToUser)] || '?',\n    offeredCard: { id: refId(t.OfferedCard), name: cardById[refId(t.OfferedCard)] || '?' },\n    requestedCard: requestedId ? { id: requestedId, name: cardById[requestedId] || '?' } : null,\n    status: t.Status,\n    createdAt: t.CreatedAt,\n    respondedAt: t.RespondedAt || null\n  };\n}).sort((a, b) => (b.createdAt || 0) - (a.createdAt || 0));\n\nreturn [{ json: { trades: list } }];"
      }
    },
