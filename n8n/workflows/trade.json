      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nconst cfg = $('Set Config').first().json;\nconst trades = $('Respond Get Trades').all().map((i) => i.json).filter((r) => r.id != null);\nconst trade = trades.find((t) => t.id === cfg.tradeId);\n\nif (!trade) {\n  return [{ json: { ok: false, error: 'trade_not_found' } }];\n}\nif (refId(trade.ToUser) !== cfg.userId) {\n  return [{ json: { ok: false, error: 'not_your_trade' } }];\n}\nif (trade.Status !== 'pending') {\n  return [{ json: { ok: false, error: 'trade_not_pending' } }];\n}\n\nreturn [{\n  json: {\n    ok: true,\n    docId: cfg.docId,\n    tradeId: trade.id,\n    fromUserId: refId(trade.FromUser),\n    toUserId: refId(trade.ToUser),\n    offeredCardId: refId(trade.OfferedCard),\n    requestedCardId: refId(trade.RequestedCard),\n    accept: cfg.accept\n  }\n}];"
