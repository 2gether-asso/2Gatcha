    {
      "id": "compute-unlock",
      "name": "Compute Unlock",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -480,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nconst cfg = $('Set Config').first().json;\nconst cards = $('Get Cards').all().map((i) => i.json).filter((r) => r.id != null);\nconst pulls = $('Get Pulls').all().map((i) => i.json).filter((r) => r.id != null);\n\n// Numeros d'exemplaire par carte : on suit QUELS numeros sont utilises\n// (pas juste un compteur) pour reattribuer le plus petit numero libre - un\n// exemplaire decrafte/defausse libere vraiment son numero. Plus de quota\n// (Cards.MaxSerial) : une carte secrete reste debloquable indefiniment.\nconst usedSerialsByCard = {};\npulls.forEach((p) => {\n  const cid = refId(p.Card);\n  if (!usedSerialsByCard[cid]) usedSerialsByCard[cid] = new Set();\n  if (p.SerialNumber != null) usedSerialsByCard[cid].add(p.SerialNumber);\n});\nfunction nextSerial(cardId) {\n  const used = usedSerialsByCard[cardId];\n  for (let n = 1; ; n++) { if (!used || !used.has(n)) return n; }\n}\n\n// Cartes secretes : un sous-ensemble des cartes promo (deja exclues du\n// tirage/craft/echange normal via IsPromo), marquees IsSecret=true.\nconst candidates = cards.filter((c) => !!c.IsSecret && c.Active !== false);\nif (!candidates.length) {\n  return [{ json: { ok: false, error: 'no_secret_available' } }];\n}\n\nconst picked = candidates[Math.floor(Math.random() * candidates.length)];\n\nreturn [{ json: {\n  ok: true,\n  docId: cfg.docId,\n  userId: cfg.userId,\n  cardId: picked.id,\n  obtainedAt: Math.floor(Date.now() / 1000),\n  batchId: `secret-${cfg.userId}-${Date.now()}`,\n  serialNumber: nextSerial(picked.id)\n} }];"
      }
    },
    {
      "id": "if-ok",
      "name": "If Ok",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -280,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "respond-error",
      "name": "Respond Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        -60,
        460
      ],
