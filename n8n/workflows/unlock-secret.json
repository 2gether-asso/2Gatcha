              "fieldValue": "={{ $json.cardId }}"
            },
            {
              "fieldId": "ObtainedAt",
              "fieldValue": "={{ $json.obtainedAt }}"
            },
            {
              "fieldId": "BatchId",
              "fieldValue": "={{ $json.batchId }}"
            },
            {
              "fieldId": "SerialNumber",
              "fieldValue": "={{ $json.serialNumber }}"
            }
          ]
        }
      },
      "credentials": {
        "gristApi": {
          "id": "Yoc8FS9lCXpWBRrk",
          "name": "Grist account"
        }
      }
    },
    {
      "id": "format-response",
      "name": "Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        140,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nfunction firstAttachment(v) {\n  if (!Array.isArray(v) || !v.length) return null;\n  const ids = v[0] === 'L' ? v.slice(1) : v;\n  return ids.length ? ids[0] : null;\n}\nconst r = $('Compute Unlock').first().json;\nconst cards = $('Get Cards').all().map((i) => i.json).filter((c) => c.id != null);\nconst card = cards.find((c) => c.id === r.cardId);\nreturn [{ json: {\n  unlocked: true,\n  card: {\n    cardId: card.id,\n    name: card.Name,\n    artist: card.Artist,\n    imageId: firstAttachment(card.Image)\n  },\n  serialNumber: r.serialNumber\n} }];"
      }
    },
    {
      "id": "respond-success",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        340,
        200
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      }
    }
  ],
