    {
      "id": "compute-weekly-quest-update",
      "name": "Compute Quest Update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -960,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function refId(v) { return Array.isArray(v) ? v[1] : v; }\nfunction toDateStr(v) { if (v == null) return null; if (typeof v === 'number') return new Date(v * 1000).toISOString().slice(0, 10); return String(v).slice(0, 10); }\nconst cfg = $('Set Config').first().json;\nconst rows = $('Get Weekly Quests').all().map((i) => i.json).filter((r) => r.id != null);\nconst row = rows.find((r) => refId(r.User) === cfg.userId && toDateStr(r.WeekStart) === cfg.weekStart);\nconst users = $('Get Users').all().map((i) => i.json).filter((r) => r.id != null);\nconst user = users.find((u) => u.id === cfg.userId);\n\nconst flags = { LoginDone: false, CraftDone: false, TradeDone: false, OpenBoosterDone: false, RewardClaimed: false };\nif (row) {\n  flags.LoginDone = !!row.LoginDone;\n  flags.CraftDone = !!row.CraftDone;\n  flags.TradeDone = !!row.TradeDone;\n  flags.OpenBoosterDone = !!row.OpenBoosterDone;\n  flags.RewardClaimed = !!row.RewardClaimed;\n}\n// Consulter ses quetes de la semaine compte comme \"se connecter\" cette semaine.\nflags.LoginDone = true;\n\nconst completedCount = ['LoginDone', 'CraftDone', 'TradeDone', 'OpenBoosterDone'].filter((k) => flags[k]).length;\nconst shouldGrantReward = completedCount >= 3 && !flags.RewardClaimed;\nif (shouldGrantReward) flags.RewardClaimed = true;\n\nconst newBoosterCount = (user ? (user.BoosterCount || 0) : 0) + (shouldGrantReward ? 5 : 0);\n\nreturn [{ json: { docId: cfg.docId, userId: cfg.userId, weekStart: cfg.weekStart, rowId: row ? row.id : null, exists: !!row, completedCount, shouldGrantReward, newBoosterCount, ...flags } }];"
      }
    },
